#!/usr/bin/python3
"""sfduo-posture: the hinge, read once and told to everyone.

    sfduo-posture            run (the session autostarts it)
    sfduo-posture --watch    print what the running one publishes

The Duo's hinge angle comes from sensorfw on the system bus (the port's
rebuilt sensorfw, `sfduo-sensorfw-install`): a session to request, a
sensor to start, and its data socket, where each reading arrives as it is
made (#140) - no polling: at rest nothing wakes. It arrives at about 10 Hz
in whole degrees, in steps of 15 degrees or more when the device is folded
briskly, and it is a fusion of both halves' accelerometers, gyroscopes and
magnetometers on the SLPI rather than an encoder in the hinge - so the
readings are honest at rest and coarse in motion.

This daemon holds the sensorfw session for its life and publishes on the
session bus, as org.sfduo.Posture at /org/sfduo/Posture:

    Angle    double   where the hinge is now, sixty times a second: the
                      readings arrive ten times a second in whole degrees,
                      fifteen apart during a brisk fold, and what goes out is
                      an estimate carried forward between them
    Raw      uint32   the last reading as sensorfw gave it
    Posture  string   closed, laptop, flat, folded, or between - with
                      hysteresis, and only after two readings agree
    Moving   boolean  the hinge is turning (over 20 degrees a second)
    Velocity double   degrees a second, signed: positive opening
    Surface  uint32   Microsoft's own posture (the sensors HAL's vendor type
                      33171009, sensorfw's posturesensor): read against the
                      ways the Duo is held (#116) - 0 closed, 3 open as a book
                      or a laptop, 5 flat, 7 closing, 13 on the way to back to
                      back, 11 back to back with the left panel facing the
                      user, 9 with the right one
    Facing   string   back to back, the panel facing the user: left or right;
                      empty otherwise
    Gravity  double[] which way is down: the accelerometer's x, y, z in g
                      (lying flat face up: about 0, 0, 1), smoothed, told
                      when it moves by 0.02 g; read while the display is lit
                      (Surface and Facing only with SFDUO_POSTURE_SURFACE=1)

Each sensorfw session connects its data socket (/run/sensord.sock): a
session that does not within ten seconds is taken for lost and its sensor
stopped - the hinge's value froze ten seconds after the start, and the dock
stopped following the hinge. The socket carries frames of a count and as
many readings, 16 bytes each: a timestamp (u64, microseconds), the value
(u32), padding. Asking the D-Bus property 25 times a second instead cost
8.6 % of a core while the screen was on.

PropertiesChanged carries every change. The dock, the fold effect and the
phone mode read these instead of talking to sensorfw themselves (#55).

While the display is off it reads nothing: the sensor is stopped, and starts
again as the display lights up (#159).
"""
import math
import os
import socket
import struct
import sys
import time

import gi

gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

SENSORFW = "com.nokia.SensorService"
# sensorfw's data socket: a session that does not connect to it within ten
# seconds of requestSensor is taken for lost - stopped and released - and
# its sensor's value is frozen from then on.
SENSORFW_SOCKET = "/run/sensord.sock"
SENSOR_MANAGER = "/SensorManager"
HINGE_PATH = "/SensorManager/hingesensor"
HINGE_IFACE = "local.HingeSensor"
SURFACE_PATH = "/SensorManager/posturesensor"
SURFACE_IFACE = "local.PostureSensor"
# Microsoft's posture: back to back, which panel faces the user.
FACING = {11: "left", 9: "right"}
# Started without an interval it reports once and never again: asked for
# one, it reports each change.
SURFACE_INTERVAL_MS = 100
# Read only when asked (SFDUO_POSTURE_SURFACE=1): nothing uses it yet (#117
# parked), and it costs the SLPI a sensor.
READ_SURFACE = os.environ.get("SFDUO_POSTURE_SURFACE") == "1"
# The accelerometer, for which way is down (item/grid draws the phone as it is
# held): sensorfw's readings are x, y, z in thousandths of g (floats), ten a
# second, read only while the display is lit, like the hinge.
ACCEL_PATH = "/SensorManager/accelerometersensor"
ACCEL_IFACE = "local.AccelerometerSensor"
ACCEL_INTERVAL_MS = 100
ACCEL_READING = struct.Struct("=Qfff4x")
GRAVITY_STEP = 0.02           # g: a smaller change is not told
GRAVITY_SMOOTH = 0.5          # each reading's share of the smoothed one

BUS_NAME = "org.sfduo.Posture"
OBJECT_PATH = "/org/sfduo/Posture"
IFACE = "org.sfduo.Posture"

# phosh says when the display goes dark and comes back: 0 on, anything else off
DISPLAY_CONFIG = "org.gnome.Mutter.DisplayConfig"
DISPLAY_CONFIG_PATH = "/org/gnome/Mutter/DisplayConfig"

READING = struct.Struct("=QI4x")  # sensorfw's TimedUnsigned on the socket
FRAME_MS = 16                 # the estimate's own clock while it moves
# A reading every hundred milliseconds, in whole degrees, fifteen at a time
# when the hinge is moving. Three ways to turn that into motion, measured
# against a real fold (the frame-to-frame change of speed is what the eye
# reads as jitter):
#
#   a spring, 16 rad/s    the speed changes every single frame - median 0.13
#                         degrees, ninth decile 0.51: a wobble at the sensor's
#                         own rate, because a spring accelerates after each
#                         step and then eases off
#   an alpha-beta filter  the speed is guessed from the surprise and carried
#                         forward: it ran 26 degrees past the end of the fold
#                         before a reading contradicted it
#   gliding               the estimate simply travels at a constant speed
#                         towards the last reading, arriving in about one and
#                         a half readings' time: no change of speed at all in
#                         nine frames out of ten, nothing past the end
#
# So it glides. The speed is set when a reading arrives and held until the
# next one; arriving a little later than the next reading is due keeps it
# moving rather than stalling, and it never passes the reading it is going to.
ARRIVE = 1.5                  # readings' worth of time to reach the last one
MOVING_DEG_S = 20.0           # angular speed that counts as the hinge turning
STILL_AFTER_MS = 400          # no new reading for this long: not moving
CONFIRM = 2                   # readings in a row before a posture changes

# Postures by angle, with the band a reading must leave to change posture
# (hysteresis): [name, low, high]. What is not in a band is "between".
POSTURES = [
    ("closed", -1, 10),
    ("laptop", 60, 130),
    ("flat", 150, 210),
    ("folded", 340, 361),
]
HYSTERESIS = 5

INTROSPECTION = """
<node>
  <interface name="org.sfduo.Posture">
    <property name="Angle" type="d" access="read"/>
    <property name="Raw" type="u" access="read"/>
    <property name="Posture" type="s" access="read"/>
    <property name="Moving" type="b" access="read"/>
    <property name="Velocity" type="d" access="read"/>
    <property name="Surface" type="u" access="read"/>
    <property name="Facing" type="s" access="read"/>
    <property name="Gravity" type="ad" access="read"/>
  </interface>
</node>
"""


def log(message):
    print(f"sfduo-posture: {message}", file=sys.stderr, flush=True)


def posture_for(angle, current):
    """The posture an angle is in, sticky to `current` within the hysteresis."""
    for name, low, high in POSTURES:
        lo, hi = (low - HYSTERESIS, high + HYSTERESIS) if name == current else (low, high)
        if lo <= angle <= hi:
            return name
    return "between"


class Posture:
    def __init__(self):
        self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sensor_session = None
        self.sockets = []             # the sessions' data sockets, kept open
        self.reconnecting = None      # the one reconnection waiting, if any
        self.surface_session = None
        self.accel_session = None
        self.gravity = [0.0, 0.0, 0.0]     # g, x y z, smoothed
        self.gravity_told = None
        self.surface = 0
        self.facing = ""
        self.raw = None
        self.raw_at = 0.0
        self.angle = None             # where the hinge is, carried between readings
        self.velocity = 0.0           # degrees a second, estimated with it
        self.clock = None
        self.last_tick = 0.0
        self.posture = "between"
        self.candidate = ("between", 0)
        self.moving = False
        self.props = {}
        self.registration = None
        self.dark = False             # the display is off: nothing is read
        self.fresh = False            # the first reading after the dark stands as it is

        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        self.registration = self.session.register_object(
            OBJECT_PATH, node.interfaces[0], None, self._get_property, None)
        Gio.bus_own_name_on_connection(self.session, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                                       None, lambda *_a: log("name lost"))
        # sensorfw restarting drops the session: request again
        self.system.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                                     "NameOwnerChanged", "/org/freedesktop/DBus", SENSORFW,
                                     Gio.DBusSignalFlags.NONE,
                                     lambda *_a: self._reconnect(1500))
        # 25 readings a second through the system bus, three processes woken
        # for each and the SLPI sensor running: all night long with the phone
        # closed, 14 % of a core and no deep idle for the CPUs (#159). Nothing
        # needs the hinge while the display is off - the lid switch wakes the
        # phone - so the reading stops with the display and starts with it.
        self.session.signal_subscribe(DISPLAY_CONFIG, "org.freedesktop.DBus.Properties",
                                      "PropertiesChanged", DISPLAY_CONFIG_PATH, None,
                                      Gio.DBusSignalFlags.NONE, self._on_display_changed)
        # The lid opened: reading at once - the display lights a second or
        # two later (the phone wakes first), and the hinge was read only from
        # then: item/grid drew the phone shut for seconds after it was opened.
        self.system.signal_subscribe("org.freedesktop.login1", "org.freedesktop.DBus.Properties",
                                     "PropertiesChanged", "/org/freedesktop/login1", None,
                                     Gio.DBusSignalFlags.NONE, self._on_logind_changed)
        # a shell that comes (back) up has its display on
        self.session.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                                      "NameOwnerChanged", "/org/freedesktop/DBus", DISPLAY_CONFIG,
                                      Gio.DBusSignalFlags.NONE,
                                      lambda *_a: self._set_dark(False))
        try:
            mode = self.session.call_sync(DISPLAY_CONFIG, DISPLAY_CONFIG_PATH,
                                          "org.freedesktop.DBus.Properties", "Get",
                                          GLib.Variant("(ss)", (DISPLAY_CONFIG, "PowerSaveMode")),
                                          None, Gio.DBusCallFlags.NONE, 1000, None)[0]
            self.dark = mode != 0
        except GLib.Error:
            pass                      # no shell yet: taken as on
        self._connect()
        if not self.dark:
            self._read_once()

    # ---- sensorfw --------------------------------------------------------

    def _reconnect(self, ms):
        """Connect again in a while - once, however many readings failed or
        the name changed hands meanwhile."""
        if self.reconnecting is None:
            self.reconnecting = GLib.timeout_add(ms, self._connect)

    def _connect(self):
        self.reconnecting = None
        # The old sessions' sockets closed: sensorfw lets those sessions go.
        for sock, watch in self.sockets:
            GLib.source_remove(watch)     # before the close: a watch on a closed fd spins
            sock.close()
        self.sockets = []
        self.sensor_session = self.surface_session = self.accel_session = None
        try:
            self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager", "loadPlugin",
                                  GLib.Variant("(s)", ("hingesensor",)), None,
                                  Gio.DBusCallFlags.NONE, 3000, None)
            reply = self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager",
                                          "requestSensor", GLib.Variant("(sx)", ("hingesensor", 0)),
                                          None, Gio.DBusCallFlags.NONE, 3000, None)
            self.sensor_session = reply[0]
            self._attach(self.sensor_session, self._on_degrees)
            if not self.dark:
                self._sensor("start")
            log(f"hinge sensor session {self.sensor_session}")
        except GLib.Error as err:
            self.sensor_session = None
            log(f"no hinge sensor yet: {err.message} (is the rebuilt sensorfw installed? sudo sfduo-sensorfw-install)")
        try:
            self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager", "loadPlugin",
                                  GLib.Variant("(s)", ("accelerometersensor",)), None,
                                  Gio.DBusCallFlags.NONE, 3000, None)
            reply = self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager",
                                          "requestSensor", GLib.Variant("(sx)", ("accelerometersensor", 0)),
                                          None, Gio.DBusCallFlags.NONE, 3000, None)
            self.accel_session = reply[0]
            self._attach(self.accel_session, self._on_accel, ACCEL_READING)
            self.system.call_sync(SENSORFW, ACCEL_PATH, ACCEL_IFACE, "setInterval",
                                  GLib.Variant("(ii)", (self.accel_session, ACCEL_INTERVAL_MS)), None,
                                  Gio.DBusCallFlags.NONE, 3000, None)
            if not self.dark:
                self._sensor("start")
            log(f"accelerometer session {self.accel_session}")
        except GLib.Error as err:
            self.accel_session = None
            log(f"no accelerometer: {err.message}")
        if not READ_SURFACE:
            return False
        try:
            self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager", "loadPlugin",
                                  GLib.Variant("(s)", ("posturesensor",)), None,
                                  Gio.DBusCallFlags.NONE, 3000, None)
            reply = self.system.call_sync(SENSORFW, SENSOR_MANAGER, "local.SensorManager",
                                          "requestSensor", GLib.Variant("(sx)", ("posturesensor", 0)),
                                          None, Gio.DBusCallFlags.NONE, 3000, None)
            self.surface_session = reply[0]
            self._attach(self.surface_session, self._on_surface)
            self.system.call_sync(SENSORFW, SURFACE_PATH, SURFACE_IFACE, "setInterval",
                                  GLib.Variant("(ii)", (self.surface_session, SURFACE_INTERVAL_MS)), None,
                                  Gio.DBusCallFlags.NONE, 3000, None)
            if not self.dark:
                self._sensor("start")
            log(f"posture sensor session {self.surface_session}")
        except GLib.Error as err:
            self.surface_session = None
            log(f"no posture sensor: {err.message} (sensorfw 0.14.8+itemae2 or later)")
        return False

    def _attach(self, session, on_value, reading=READING):
        """Connect the session's data socket, as sensorfw's client library
        does: it greets with a newline, the session's number goes back. Then
        each frame's last reading goes to `on_value`: its value (a hinge's
        degrees), or its x, y, z (an accelerometer's, `reading` ACCEL_READING)."""
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(SENSORFW_SOCKET)
            sock.settimeout(2)
            sock.recv(1)
            sock.sendall(struct.pack("=i", session))
            sock.setblocking(False)
        except OSError as err:
            log(f"session {session}: no data socket: {err}")
            return
        pending = bytearray()

        def drain(fd, condition):
            try:
                data = sock.recv(65536)
                if data:
                    pending.extend(data)
                    last = None
                    while len(pending) >= 4:
                        count = struct.unpack_from("=I", pending)[0]
                        end = 4 + reading.size * count
                        if count > 1000:          # out of step: start over
                            pending.clear()
                            break
                        if len(pending) < end:
                            break
                        if count:
                            fields = reading.unpack_from(pending, end - reading.size)[1:]
                            last = fields[0] if len(fields) == 1 else fields
                        del pending[:end]
                    if last is not None:
                        on_value(last)
                    return True
            except BlockingIOError:
                return True
            except OSError:
                pass
            sock.close()                  # sensorfw went away: _connect starts again
            self.sockets = [(s, w) for s, w in self.sockets if s is not sock]
            return False
        watch = GLib.io_add_watch(sock.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, drain)
        self.sockets.append((sock, watch))

    def _sensor(self, method):
        """Start or stop the hinge and posture sensors on the SLPI."""
        for session, path, iface in ((self.sensor_session, HINGE_PATH, HINGE_IFACE),
                                     (self.surface_session, SURFACE_PATH, SURFACE_IFACE),
                                     (self.accel_session, ACCEL_PATH, ACCEL_IFACE)):
            if session is None:
                continue
            try:
                self.system.call_sync(SENSORFW, path, iface, method,
                                      GLib.Variant("(i)", (session,)), None,
                                      Gio.DBusCallFlags.NONE, 3000, None)
            except GLib.Error as err:
                log(f"{method} {path}: {err.message}")

    # ---- the display ---------------------------------------------------------

    def _on_display_changed(self, conn, sender, path, iface, signal, params):
        mode = params[1].get("PowerSaveMode")
        if mode is not None:
            self._set_dark(mode != 0)

    def _on_logind_changed(self, conn, sender, path, iface, signal, params):
        if params[1].get("LidClosed") is False and self.dark:
            log("lid opened: reading the hinge")
            self._set_dark(False)
            # Dark again if the display never lit after all (the battery).
            GLib.timeout_add_seconds(8, self._dark_if_still)

    def _dark_if_still(self):
        try:
            mode = self.session.call_sync(DISPLAY_CONFIG, DISPLAY_CONFIG_PATH,
                                          "org.freedesktop.DBus.Properties", "Get",
                                          GLib.Variant("(ss)", (DISPLAY_CONFIG, "PowerSaveMode")),
                                          None, Gio.DBusCallFlags.NONE, 1000, None)[0]
            if mode != 0:
                self._set_dark(True)
        except GLib.Error:
            pass
        return False

    def _set_dark(self, dark):
        if dark == self.dark:
            return
        self.dark = dark
        if dark:
            self._sensor("stop")
            log("display off: not reading the hinge")
            return
        # The hinge may have turned any distance in the dark: the first
        # reading is where it is, not a place to glide to from the old one.
        self.fresh = True
        self._sensor("start")
        self._read_once()
        log("display on: reading the hinge")

    def _read_once(self):
        """The hinge's value asked for once (at the start, and as the display
        lights: the socket brings only changes)."""
        if self.sensor_session is None:
            return
        self.system.call(SENSORFW, HINGE_PATH, "org.freedesktop.DBus.Properties", "Get",
                         GLib.Variant("(ss)", (HINGE_IFACE, "hinge")), None,
                         Gio.DBusCallFlags.NONE, 500, None, self._on_reading)

    def _on_reading(self, conn, result):
        try:
            value = conn.call_finish(result)
        except GLib.Error as err:
            log(f"reading failed: {err.message}")
            self.sensor_session = None
            self._reconnect(2000)
            return
        # (timestamp, degrees) in a variant
        reading = value[0]
        self._on_degrees(int(reading[1]) if isinstance(reading, tuple) else int(reading))

    def _on_degrees(self, degrees):
        now = time.monotonic()
        if self.dark:
            return                            # a reading asked for before the dark
        if self.fresh:                        # the first since the dark: at rest, where it is
            self.fresh = False
            if self.clock is not None:
                GLib.source_remove(self.clock)
                self.clock = None
            self.raw, self.raw_at = degrees, now
            self.angle, self.velocity = float(degrees), 0.0
            changed = {"Angle": self.angle, "Raw": degrees}
            name = posture_for(degrees, self.posture)
            if name != self.posture:
                self.posture = name
                changed["Posture"] = name
            self.candidate = (self.posture, 0)
            if self.moving:
                self.moving = False
                changed.update({"Moving": False, "Velocity": 0.0})
            self._publish(changed)
            return
        if degrees == self.raw:
            return
        if self.raw is None:                  # the first reading: nothing to travel from
            self.raw, self.raw_at = degrees, now
            self.angle, self.velocity = float(degrees), 0.0
            self._update_posture(degrees)
            self._publish({"Angle": self.angle, "Raw": degrees})
            return
        interval = max(0.05, min(0.3, now - self.raw_at))
        self.velocity = (degrees - self.angle) / (ARRIVE * interval)
        self.raw, self.raw_at = degrees, now
        self._update_posture(degrees)
        self._update_moving(now)
        self._publish({"Raw": degrees})
        self._start_clock()

    def _on_surface(self, surface):
        if surface == self.surface:
            return
        self.surface = surface
        changed = {"Surface": surface}
        # Between two facings (13, the turn) the last one stands.
        facing = FACING.get(surface, self.facing if surface == 13 else "")
        if facing != self.facing:
            self.facing = facing
            changed["Facing"] = facing
            log(f"facing: {facing or 'none'}")
        self._publish(changed)

    def _on_accel(self, xyz):
        """Which way is down, smoothed: told when it moves by GRAVITY_STEP."""
        if self.dark:
            return
        g = [v / 1000.0 for v in xyz]
        if self.gravity_told is None:
            self.gravity = g
        else:
            self.gravity = [o + (n - o) * GRAVITY_SMOOTH for o, n in zip(self.gravity, g)]
        if self.gravity_told is None or max(abs(a - b) for a, b in zip(self.gravity, self.gravity_told)) >= GRAVITY_STEP:
            self.gravity_told = list(self.gravity)
            self._publish({"Gravity": [round(v, 3) for v in self.gravity]})

    # ---- gliding to the last reading ---------------------------------------

    def _start_clock(self):
        if self.clock is None:
            self.last_tick = time.monotonic()
            self.clock = GLib.timeout_add(FRAME_MS, self._tick)

    def _tick(self):
        now = time.monotonic()
        dt = min(now - self.last_tick, 0.05)
        self.last_tick = now
        angle = self.angle + self.velocity * dt
        arrived = ((self.velocity > 0 and angle >= self.raw)
                   or (self.velocity < 0 and angle <= self.raw)
                   or self.velocity == 0)
        if arrived:
            self.angle, self.velocity = float(self.raw), 0.0
            self.clock = None
            self._publish({"Angle": self.angle})
            self._update_moving(now)
            return False
        self.angle = angle
        self._publish({"Angle": self.angle})
        self._update_moving(now)
        return True

    # ---- posture and motion ------------------------------------------------

    def _update_posture(self, degrees):
        name = posture_for(degrees, self.posture)
        if name == self.posture:
            self.candidate = (name, 0)
            return
        cand, count = self.candidate
        count = count + 1 if cand == name else 1
        self.candidate = (name, count)
        if count >= CONFIRM:
            self.posture = name
            self.candidate = (name, 0)
            self._publish({"Posture": name})

    def _update_moving(self, now):
        moving = abs(self.velocity) >= MOVING_DEG_S and (now - self.raw_at) * 1000 < STILL_AFTER_MS
        if moving != self.moving:
            self.moving = moving
            self._publish({"Moving": moving, "Velocity": self.velocity})

    # ---- D-Bus ------------------------------------------------------------

    def _get_property(self, conn, sender, path, iface, name):
        if name == "Angle":
            return GLib.Variant("d", self.angle if self.angle is not None else 0.0)
        if name == "Raw":
            return GLib.Variant("u", self.raw if self.raw is not None else 0)
        if name == "Posture":
            return GLib.Variant("s", self.posture)
        if name == "Moving":
            return GLib.Variant("b", self.moving)
        if name == "Velocity":
            return GLib.Variant("d", self.velocity)
        if name == "Surface":
            return GLib.Variant("u", self.surface)
        if name == "Facing":
            return GLib.Variant("s", self.facing)
        if name == "Gravity":
            return GLib.Variant("ad", self.gravity)
        return None

    def _publish(self, changed):
        for key, value in changed.items():
            self.props[key] = value
        variants = {}
        for key, value in changed.items():
            sig = {"Angle": "d", "Raw": "u", "Posture": "s", "Moving": "b", "Velocity": "d",
                   "Surface": "u", "Facing": "s", "Gravity": "ad"}[key]
            variants[key] = GLib.Variant(sig, value)
        try:
            self.session.emit_signal(None, OBJECT_PATH, "org.freedesktop.DBus.Properties",
                                     "PropertiesChanged",
                                     GLib.Variant("(sa{sv}as)", (IFACE, variants, [])))
        except GLib.Error as err:
            log(f"emit: {err.message}")


def watch():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def on_change(conn, sender, path, iface, signal, params):
        changed = params[1]
        print(" ".join(f"{k}={changed[k]:.1f}" if isinstance(changed[k], float) else f"{k}={changed[k]}"
                       for k in changed.keys()), flush=True)
    bus.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         OBJECT_PATH, IFACE, Gio.DBusSignalFlags.NONE, on_change)
    try:
        value = bus.call_sync(BUS_NAME, OBJECT_PATH, "org.freedesktop.DBus.Properties", "GetAll",
                              GLib.Variant("(s)", (IFACE,)), None, Gio.DBusCallFlags.NONE, 1000, None)
        print("now:", {k: (round(v, 1) if isinstance(v, float) else v) for k, v in value[0].items()}, flush=True)
    except GLib.Error as err:
        sys.exit(f"sfduo-posture: not running? {err.message}")
    GLib.MainLoop().run()


def main(argv):
    if "--watch" in argv:
        watch()
        return
    Posture()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main(sys.argv[1:])
