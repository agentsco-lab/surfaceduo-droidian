#!/bin/sh
# sfduo-osk-install: put the port's patched on-screen keyboard in place of the
# packaged one - or, with --restore, put the packaged one back and keep it there.
#
# The keyboard is phosh-osk-stub on Droidian 101 and the same program
# renamed, phosh-osk-stevia, on 102; the package carries a patched build of
# each (adaptation/shell/osk-patches: on a display whose phoc.ini names a
# `tiling-seam`, the keyboard takes the right panel in landscape instead of
# running across both, with 60 px rows), each in a directory named after the
# exact version it was built for: /usr/lib/sfduo/osk/<package>/<version>/.
# Version-locked, with the marker and --restore of sfduo-phosh-install. The
# keyboard is restarted by phosh; restarting the shell picks the new binary
# up.
set -e
PKG=phosh-osk-stub
if dpkg-query -W -f='${Status}' phosh-osk-stevia 2>/dev/null | grep -q "ok installed"; then
    PKG=phosh-osk-stevia
fi
HAVE=$(dpkg-query -W -f='${Version}' "$PKG" 2>/dev/null || true)
OURS=/usr/lib/sfduo/osk/$PKG/$HAVE/$PKG
# the two-panel shell's own build (agentsco-lab/item), while it is installed
[ -f "/usr/lib/item/osk/$PKG/$HAVE/$PKG" ] && OURS=/usr/lib/item/osk/$PKG/$HAVE/$PKG
WANT=$HAVE
if [ ! -f "$OURS" ] && [ "$PKG" = phosh-osk-stub ]; then
    # packages before 0.20: one build, its version beside it
    OURS=/usr/lib/sfduo/osk/phosh-osk-stub
    WANT=$(cat /usr/lib/sfduo/osk/version 2>/dev/null || true)
fi
BIN=/usr/bin/$PKG
STOCK=/usr/bin/$PKG.stock
KEEP_STOCK=/etc/sfduo/osk-stock

case "$1" in
--restore)
    [ -f "$STOCK" ] || { echo "sfduo-osk: no $STOCK to restore" >&2; exit 1; }
    mkdir -p "$(dirname "$KEEP_STOCK")"
    : > "$KEEP_STOCK"
    if cmp -s "$STOCK" "$BIN"; then
        echo "sfduo-osk: packaged $PKG already in place; it now stays through package upgrades"
    else
        cp -a "$STOCK" "$BIN.tmp" && mv -f "$BIN.tmp" "$BIN"
        echo "sfduo-osk: packaged $PKG restored - restart the shell (sudo systemctl restart phosh)"
    fi
    echo "sfduo-osk: it stays through package upgrades until 'sfduo-osk-install --patched'."
    echo "sfduo-osk: the keyboard runs across both panels again."
    exit 0
    ;;
--patched)
    rm -f "$KEEP_STOCK"
    ;;
"")
    if [ -f "$KEEP_STOCK" ]; then
        echo "sfduo-osk: packaged $PKG kept, as --restore asked ($KEEP_STOCK); 'sfduo-osk-install --patched' undoes that"
        exit 0
    fi
    ;;
*)
    echo "usage: sfduo-osk-install [--restore | --patched]" >&2
    exit 2
    ;;
esac

if [ ! -f "$OURS" ] || [ -z "$WANT" ] || [ "$HAVE" != "$WANT" ]; then
    echo "sfduo-osk: $PKG is ${HAVE:-not installed}, and this package has no build for it - left alone;"
    echo "sfduo-osk: the keyboard runs across both panels on this one"
    exit 0
fi
if cmp -s "$OURS" "$BIN"; then
    echo "sfduo-osk: patched $PKG already in place"
    exit 0
fi
[ -f "$STOCK" ] || cp -a "$BIN" "$STOCK"
cp -a "$OURS" "$BIN.tmp" && chmod 755 "$BIN.tmp" && mv -f "$BIN.tmp" "$BIN"
echo "sfduo-osk: patched $PKG installed (packaged one kept as $STOCK) - restart the shell (sudo systemctl restart phosh)"
