From 1e10fdba97ccc9f503afadd526aff75dee69b16b Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Tue, 29 Sep 2026 01:00:47 +0300
Subject: [PATCH 12/13] view: a window maximized before it is mapped goes to
 the panel touched last

With auto-maximize, a new window is maximized at its first commit, before
it is placed: it stood at the output's corner, and on an output with a
seam maximized means the panel its centre is over - the left one, whatever
panel its launcher was tapped on. A window not yet mapped now goes to the
panel touched last, as a new floating window is centred there.
---
 src/view.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/view.c b/src/view.c
index aaeeb41..82f1a56 100644
--- a/src/view.c
+++ b/src/view.c
@@ -1375,6 +1375,19 @@ view_seam_side (PhocView *self, PhocOutput *output, PhocViewTileDirection *dir)
 
   wlr_output_layout_get_box (desktop->layout, output->wlr_output, &output_box);
   centre = self->box.x + self->box.width * priv->scale / 2.0;
+  /* A window maximized before it is mapped - auto-maximize does it at its
+   * first commit - has not been placed yet and stands at the output's
+   * corner: it goes to the panel touched last, where its launcher was
+   * tapped, as a new floating window is centred there (view_center). */
+  if (!phoc_view_is_mapped (self)) {
+    PhocInput *input = phoc_server_get_input (phoc_server_get_default ());
+    PhocSeat *seat = phoc_input_get_last_active_seat (input);
+
+    if (seat) {
+      PhocCursor *cursor = phoc_seat_get_cursor (seat);
+      centre = seat->touch_x > 0 ? seat->touch_x : cursor->cursor->x;
+    }
+  }
   *dir = centre < output_box.x + output_box.width / 2.0 ? PHOC_VIEW_TILE_LEFT : PHOC_VIEW_TILE_RIGHT;
   return TRUE;
 }
