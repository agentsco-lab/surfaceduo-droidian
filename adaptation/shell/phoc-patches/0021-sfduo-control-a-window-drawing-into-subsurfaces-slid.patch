From 5e23547aaf7bd94d2d0920fa42bf6d42981b8ad7 Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <ivanverbovoy@gmail.com>
Date: Sat, 26 Sep 2026 14:15:12 +0300
Subject: [PATCH] sfduo-control: a window drawing into subsurfaces slides
 itself to the other panel

Firefox puts its page in a subsurface of its own, which the ghost does not
carry: it vanished from one panel and turned up on the other. Such a window
now travels itself, moved a step each frame on the ghost's curve and time
(the easer eases floats, so the progress is one). The ghost's target is in
the output's units, the tile in the window's: a window fitted into a panel by
scaling jumped. A window fitted into a panel is scaled by its width alone, so
a shorter panel (the keyboard's reservation) does not shrink it whole.
---
 src/sfduo-control.c | 166 +++++++++++++++++++++++++++++++++++++++++++-
 src/view.c          |   7 +-
 2 files changed, 170 insertions(+), 3 deletions(-)

diff --git a/src/sfduo-control.c b/src/sfduo-control.c
index abe01b4..89c80c9 100644
--- a/src/sfduo-control.c
+++ b/src/sfduo-control.c
@@ -16,6 +16,9 @@
 #include "sfduo-control.h"
 #include "view.h"
 #include "view-ghost.h"
+#include "output.h"
+
+#include <wlr/types/wlr_compositor.h>
 
 #include <gio/gio.h>
 
@@ -158,6 +161,156 @@ view_is_held (PhocView *view)
 }
 
 
+/*
+ * A window that draws into subsurfaces of its own - Firefox puts its page in
+ * one - is not what the ghost can carry: the ghost is the window's main
+ * surface alone, which there is little more than its frame, and the window
+ * is hidden while it travels. Firefox vanished from one panel and turned
+ * up on the other. Such a window travels itself instead, moved a step each
+ * frame of the output, on the ghost's curve and time; its size does not
+ * change on the way, so nothing is redrawn.
+ */
+#define SFDUO_SLIDE_MS 260   /* PHOC_ANIM_DURATION_WINDOW_MOVE, the ghost's */
+
+#define PHOC_TYPE_SFDUO_SLIDE (phoc_sfduo_slide_get_type ())
+G_DECLARE_FINAL_TYPE (PhocSfduoSlide, phoc_sfduo_slide, PHOC, SFDUO_SLIDE, GObject)
+
+struct _PhocSfduoSlide {
+  GObject   parent;
+  PhocView *view;           /* weak */
+  double    x0, y0, x1, y1;
+  float     progress;         /* PhocPropertyEaser eases floats and ints only */
+};
+
+G_DEFINE_TYPE (PhocSfduoSlide, phoc_sfduo_slide, G_TYPE_OBJECT)
+
+enum {
+  SLIDE_PROP_0,
+  SLIDE_PROP_PROGRESS,
+  SLIDE_PROP_LAST
+};
+static GParamSpec *slide_props[SLIDE_PROP_LAST];
+
+
+static void
+phoc_sfduo_slide_set_property (GObject *object, guint id, const GValue *value, GParamSpec *pspec)
+{
+  PhocSfduoSlide *self = PHOC_SFDUO_SLIDE (object);
+
+  switch (id) {
+  case SLIDE_PROP_PROGRESS:
+    self->progress = g_value_get_float (value);
+    if (self->view)
+      phoc_view_move (self->view,
+                      self->x0 + (self->x1 - self->x0) * self->progress,
+                      self->y0 + (self->y1 - self->y0) * self->progress);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, id, pspec);
+  }
+}
+
+
+static void
+phoc_sfduo_slide_get_property (GObject *object, guint id, GValue *value, GParamSpec *pspec)
+{
+  PhocSfduoSlide *self = PHOC_SFDUO_SLIDE (object);
+
+  switch (id) {
+  case SLIDE_PROP_PROGRESS:
+    g_value_set_float (value, self->progress);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, id, pspec);
+  }
+}
+
+
+static void
+phoc_sfduo_slide_dispose (GObject *object)
+{
+  PhocSfduoSlide *self = PHOC_SFDUO_SLIDE (object);
+
+  if (self->view) {
+    g_object_remove_weak_pointer (G_OBJECT (self->view), (gpointer *) &self->view);
+    self->view = NULL;
+  }
+  G_OBJECT_CLASS (phoc_sfduo_slide_parent_class)->dispose (object);
+}
+
+
+static void
+phoc_sfduo_slide_class_init (PhocSfduoSlideClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = phoc_sfduo_slide_set_property;
+  object_class->get_property = phoc_sfduo_slide_get_property;
+  object_class->dispose = phoc_sfduo_slide_dispose;
+  slide_props[SLIDE_PROP_PROGRESS] =
+    g_param_spec_float ("progress", "", "", 0.0, 1.0, 0.0,
+                         G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);
+  g_object_class_install_properties (object_class, SLIDE_PROP_LAST, slide_props);
+}
+
+
+static void
+phoc_sfduo_slide_init (PhocSfduoSlide *self)
+{
+}
+
+
+static gboolean
+view_has_subsurfaces (PhocView *view)
+{
+  struct wlr_surface *surface = view->wlr_surface;
+
+  return surface && (!wl_list_empty (&surface->current.subsurfaces_above) ||
+                     !wl_list_empty (&surface->current.subsurfaces_below));
+}
+
+
+static void
+slide_view_itself (PhocView *view, PhocViewTileDirection dir)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  g_autoptr (PhocTimedAnimation) anim = NULL;
+  g_autoptr (PhocPropertyEaser) easer = NULL;
+  PhocOutput *output = phoc_view_get_output (view);
+  PhocSfduoSlide *slide;
+  double x0 = view->box.x, y0 = view->box.y;
+
+  phoc_view_tile (view, dir, NULL);
+  if (output == NULL || !phoc_desktop_get_enable_animations (desktop) ||
+      (view->box.x == x0 && view->box.y == y0))
+    return;
+
+  slide = g_object_new (PHOC_TYPE_SFDUO_SLIDE, NULL);
+  slide->view = view;
+  g_object_add_weak_pointer (G_OBJECT (view), (gpointer *) &slide->view);
+  slide->x0 = x0;
+  slide->y0 = y0;
+  slide->x1 = view->box.x;
+  slide->y1 = view->box.y;
+  phoc_view_move (view, x0, y0);
+
+  easer = g_object_new (PHOC_TYPE_PROPERTY_EASER,
+                        "target", slide,
+                        "easing", PHOC_EASING_EASE_IN_OUT_CUBIC,
+                        NULL);
+  phoc_property_easer_set_props (easer, "progress", 0.0, 1.0, NULL);
+  anim = g_object_new (PHOC_TYPE_TIMED_ANIMATION,
+                       "animatable", output,
+                       "duration", SFDUO_SLIDE_MS,
+                       "property-easer", easer,
+                       "dispose-on-done", TRUE,
+                       NULL);
+  /* the slide lives as long as its animation */
+  g_object_set_data_full (G_OBJECT (anim), "sfduo-slide", slide, g_object_unref);
+  phoc_timed_animation_play (anim);
+}
+
+
 static void
 tile_view (PhocView *view, PhocViewTileDirection dir)
 {
@@ -177,6 +330,11 @@ tile_view (PhocView *view, PhocViewTileDirection dir)
     return;
   }
 
+  if (view_has_subsurfaces (view)) {
+    slide_view_itself (view, dir);
+    return;
+  }
+
   /* Where the window is and where it is going. Both are the window's own
    * rectangle - its geometry, which is what the ghost draws - so this is
    * where it stands now and the tile it has been given; its size does not
@@ -195,8 +353,12 @@ tile_view (PhocView *view, PhocViewTileDirection dir)
       .width = geom.width * scale, .height = geom.height * scale,
     };
     to = from;
-    to.x = tiled.x;
-    to.y = tiled.y;
+    /* the tile comes in the window's own units - the output's divided by
+     * its scale - and the ghost travels in the output's: for a window
+     * fitted into a panel by scaling it down (Firefox, wider than a panel)
+     * the two are not the same, and it jumped rather than slid */
+    to.x = tiled.x * scale;
+    to.y = tiled.y * scale;
     phoc_view_tile (view, dir, NULL);
     phoc_view_ghost_move (view, &from, &to);
     return;
diff --git a/src/view.c b/src/view.c
index 24635ee..4dee97d 100644
--- a/src/view.c
+++ b/src/view.c
@@ -1397,10 +1397,15 @@ view_update_scale (PhocView *view)
   if (fit_tile || priv->scale_to_fit || phoc_desktop_get_scale_to_fit (desktop)) {
     scalex = area.width / (float)view->box.width;
     scaley = area.height / (float)view->box.height;
-    if (scaley < scalex)
+    if (scaley < scalex && !fit_tile)
       priv->scale = scaley;
     else
       priv->scale = scalex;
+    /* A window fitted into a panel is scaled by its width alone: its height
+     * is asked for to fill the panel (view_place_fitted). Taken from the
+     * height too, a panel made shorter - the gesture band or the keyboard
+     * reserving its bottom (layer-shell.c) - shrank the window whole, with
+     * a margin down each side, and the height asked for kept it there. */
 
     if (priv->scale < 0.5f)
       priv->scale = 0.5f;
-- 
2.43.0

