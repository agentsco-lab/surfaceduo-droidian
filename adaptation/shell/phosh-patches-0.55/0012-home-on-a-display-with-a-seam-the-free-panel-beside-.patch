+/*
+ * On a display with a seam, a window on one panel left the other standing
+ * empty - only the wallpaper, and no way to start a second app beside the
+ * first. There home unfolds on the free panel alone, as that panel's
+ * desktop: the app grid, as with nothing open, narrowed to the panel by its
+ * margins. An app started from it opens on that panel (phoc: the panel
+ * touched last), and with both panels taken home folds to its bar across
+ * the display again. It does not take the keyboard there - the window
+ * beside it keeps it - and the wallpaper behind it narrows with it, since
+ * across the display it would cover that window.
+ */
+#define PHOSH_HOME_FADE_OUT_MS     90
+#define PHOSH_HOME_REFLOW_HOLD_MS  70
+#define PHOSH_HOME_FADE_IN_MS     180
+
+static void phosh_home_sync_panels (PhoshHome *self);
+
+
+/* stopped from here, an animation's done callback has nothing to do */
+static void
+phosh_home_stop_animation (PhoshHome *self, PhoshAnimation **animation)
+{
+  if (*animation) {
+    self->anim_stopping = TRUE;
+    phosh_animation_stop (*animation);
+    self->anim_stopping = FALSE;
+  }
+  g_clear_pointer (animation, phosh_animation_unref);
+}
+
+static void
+fade_in_value_cb (double value, PhoshHome *self)
+{
+  phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), value);
+}
+
+
+static void
+fade_in_done_cb (PhoshHome *self)
+{
+  if (self->anim_stopping)
+    return;
+
+  phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), 1.0);
+  g_clear_pointer (&self->fade_in, phosh_animation_unref);
+}
+
+
+static void
+on_reflow_hold_done (gpointer data)
+{
+  PhoshHome *self = PHOSH_HOME (data);
+  PhoshLayerSurface *layer_surface = PHOSH_LAYER_SURFACE (self);
+
+  self->fade_in_id = 0;
+  /* The compositor's new width can come before GTK has restyled home for its
+   * new place, and a window is never made narrower than its content asks:
+   * home stayed ~930 px wide on a 675 px panel, across the hinge. Restyled
+   * by now, it is asked for the compositor's width again. */
+  gtk_window_resize (GTK_WINDOW (self),
+                     phosh_layer_surface_get_configured_width (layer_surface),
+                     phosh_layer_surface_get_configured_height (layer_surface));
+
+  if (self->state != PHOSH_HOME_STATE_UNFOLDED) {
+    phosh_layer_surface_set_alpha (layer_surface, 1.0);
+    return;
+  }
+
+  g_clear_pointer (&self->fade_in, phosh_animation_unref);
+  self->fade_in = phosh_animation_new (GTK_WIDGET (self),
+                                       0.0,
+                                       1.0,
+                                       PHOSH_HOME_FADE_IN_MS * PHOSH_ANIMATION_SLOWDOWN,
+                                       PHOSH_ANIMATION_TYPE_EASE_OUT_CUBIC,
+                                       (PhoshAnimationValueCallback) fade_in_value_cb,
+                                       (PhoshAnimationDoneCallback) fade_in_done_cb,
+                                       self);
+  phosh_animation_start (self->fade_in);
+}
+
+
+static void
+fade_out_value_cb (double value, PhoshHome *self)
+{
+  phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), value);
+}
+
+
+static void
+fade_out_done_cb (PhoshHome *self)
+{
+  if (self->anim_stopping)
+    return;
+
+  g_clear_pointer (&self->fade_out, phosh_animation_unref);
+  phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), 0.0);
+  /* out of sight now: take the new place */
+  self->reflow_ready = TRUE;
+  phosh_home_sync_panels (self);
+}
+
+
+static void
+phosh_home_fade_out (PhoshHome *self)
+{
+  double from = 1.0;
+
+  if (self->fade_out)
+    return;
+
+  g_clear_handle_id (&self->fade_in_id, g_source_remove);
+  if (self->fade_in)
+    from = phosh_animation_get_value (self->fade_in);
+  phosh_home_stop_animation (self, &self->fade_in);
+
+  self->fade_out = phosh_animation_new (GTK_WIDGET (self),
+                                        from,
+                                        0.0,
+                                        PHOSH_HOME_FADE_OUT_MS * PHOSH_ANIMATION_SLOWDOWN,
+                                        PHOSH_ANIMATION_TYPE_EASE_OUT_CUBIC,
+                                        (PhoshAnimationValueCallback) fade_out_value_cb,
+                                        (PhoshAnimationDoneCallback) fade_out_done_cb,
+                                        self);
+  phosh_animation_start (self->fade_out);
+}
+
+
+/*
+ * Home changing its width while standing - moving beside a new window, or
+ * back across the display - reflows: six columns become three, or three six.
+ * Drawn as it happens that was two jumps, the old width's last frame cut
+ * off over the new window and then the new grid at once. So home fades out
+ * first (phosh_home_fade_out: the new window shows through as it goes),
+ * takes its new width while it cannot be seen, and fades back in once the
+ * compositor has sized it and GTK has drawn it again.
+ */
+static void
+phosh_home_hide_reflow (PhoshHome *self)
+{
+  phosh_home_stop_animation (self, &self->fade_in);
+  /* folded, only the bar shows, and it may as well stay */
+  if (self->state == PHOSH_HOME_STATE_UNFOLDED)
+    phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), 0.0);
+
+  g_clear_handle_id (&self->fade_in_id, g_source_remove);
+  self->fade_in_id = g_timeout_add_once (PHOSH_HOME_REFLOW_HOLD_MS, on_reflow_hold_done, self);
+  g_source_set_name_by_id (self->fade_in_id, "[phosh] home reflow hold");
+}
+
+
+static gboolean
+phosh_home_one_free_panel (PhoshHome *self, int *left, int *right)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (shell);
+  GdkRectangle seam;
+
+  guint taken = self->panels_taken ?: self->expected_panel;
+
+  *left = *right = 0;
+  if (self->overview_forced || (taken != 1 && taken != 2))
+    return FALSE;
+
+  if (!monitor || !phosh_layout_manager_get_seam (phosh_shell_get_layout_manager (shell), &seam))
+    return FALSE;
+
+  if (taken == 1)                       /* left taken: the right one is free */
+    *left = seam.x + seam.width;
+  else
+    *right = monitor->logical.width - seam.x;
+
+  return TRUE;
+}
+
+
+#define PHOSH_HOME_HANDLE_HEIGHT     15
+#define PHOSH_HOME_HANDLE_PULL       30
+
+static const char handle_css[] =
+  "window.phosh-home-handle { background-color: transparent; }\n"
+  "window.phosh-home-handle .phosh-home-handle-pill {"
+  "  background-color: rgba(255, 255, 255, 0.6); border-radius: 3px;"
+  "  min-width: 120px; min-height: 5px; margin: 5px 0; }\n";
+
+
+/*
+ * Beside the desktop the window's panel had nothing to pull the overview up
+ * by - the overview is how a window is switched to or closed, and home, its
+ * surface, stands on the other panel. A handle along the bottom of the
+ * window's panel, where the home bar is, brings it up across the display
+ * with its cards as ever; choosing a card, or leaving, puts the desktop
+ * back beside the window.
+ */
+static void
+on_handle_drag_update (PhoshHome *self, double offset_x, double offset_y, GtkGestureDrag *drag)
+{
+  if (offset_y > -PHOSH_HOME_HANDLE_PULL || self->overview_forced)
+    return;
+
+  gtk_gesture_set_state (GTK_GESTURE (drag), GTK_EVENT_SEQUENCE_CLAIMED);
+  g_debug ("Overview pulled up from beside the desktop");
+  self->overview_forced = TRUE;
+  phosh_home_sync_panels (self);
+}
+
+
+static void
+phosh_home_create_handle (PhoshHome *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (shell);
+  g_autoptr (GtkCssProvider) provider = gtk_css_provider_new ();
+  GtkWidget *evbox, *pill;
+
+  if (!monitor)
+    return;
+
+  self->handle = g_object_new (PHOSH_TYPE_LAYER_SURFACE,
+                               "layer-shell", phosh_wayland_get_zwlr_layer_shell_v1 (phosh_wayland_get_default ()),
+                               "wl-output", monitor->wl_output,
+                               "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                                         ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
+                                         ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
+                               "layer", ZWLR_LAYER_SHELL_V1_LAYER_TOP,
+                               "kbd-interactivity", FALSE,
+                               "exclusive-zone", 0,
+                               "height", PHOSH_HOME_HANDLE_HEIGHT,
+                               "namespace", "phosh home handle",
+                               NULL);
+  gtk_css_provider_load_from_data (provider, handle_css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (),
+                                             GTK_STYLE_PROVIDER (provider),
+                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->handle), "phosh-home-handle");
+
+  evbox = gtk_event_box_new ();
+  gtk_widget_set_visible (evbox, TRUE);
+  pill = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_halign (pill, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (pill, GTK_ALIGN_END);
+  gtk_style_context_add_class (gtk_widget_get_style_context (pill), "phosh-home-handle-pill");
+  gtk_widget_set_visible (pill, TRUE);
+  gtk_container_add (GTK_CONTAINER (evbox), pill);
+  gtk_container_add (GTK_CONTAINER (self->handle), evbox);
+
+  self->handle_drag = gtk_gesture_drag_new (evbox);
+  gtk_gesture_single_set_touch_only (GTK_GESTURE_SINGLE (self->handle_drag), FALSE);
+  g_signal_connect_object (self->handle_drag, "drag-update",
+                           G_CALLBACK (on_handle_drag_update), self, G_CONNECT_SWAPPED);
+}
+
+
+static void
+phosh_home_update_handle (PhoshHome *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (shell);
+  guint taken = self->panels_taken ?: self->expected_panel;
+  GdkRectangle seam;
+  gboolean want;
+
+  want = self->on_one_panel && !self->overview_forced && monitor &&
+    self->state == PHOSH_HOME_STATE_UNFOLDED && gtk_widget_get_visible (GTK_WIDGET (self)) &&
+    phosh_layout_manager_get_seam (phosh_shell_get_layout_manager (shell), &seam);
+
+  if (!want) {
+    if (self->handle)
+      gtk_widget_set_visible (self->handle, FALSE);
+    return;
+  }
+
+  if (!self->handle)
+    phosh_home_create_handle (self);
+  if (!self->handle)
+    return;
+
+  if (taken == 1)               /* the window is on the left panel */
+    phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self->handle), 0,
+                                     monitor->logical.width - seam.x, 0, 0);
+  else
+    phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self->handle), 0,
+                                     0, 0, seam.x + seam.width);
+  gtk_widget_set_visible (self->handle, TRUE);
+}
+
+
+static void
+phosh_home_sync_panels (PhoshHome *self)
+{
+  PhoshDragSurfaceState drag_state = phosh_drag_surface_get_drag_state (PHOSH_DRAG_SURFACE (self));
+  int top, right, bottom, left, want_left, want_right;
+  gboolean one, changed;
+
+  if (!gtk_widget_get_visible (GTK_WIDGET (self)))
+    return;
+
+  /* Nothing moves under a fold in flight: the compositor animates the
+   * surface it was given, and a new width or new cards mid-way left home
+   * stuck half open across both panels. Its end syncs again. */
+  if (drag_state == PHOSH_DRAG_SURFACE_STATE_DRAGGED || self->animating)
+    return;
+
+  one = phosh_home_one_free_panel (self, &want_left, &want_right);
+
+  /* A card is how the overview shows what runs, and how it is closed: none
+   * beside a window, where home is a desktop, and none while nothing runs
+   * yet - the card of an app starting pushed the grid down for as long as
+   * it took. */
+  phosh_overview_set_hide_activities (PHOSH_OVERVIEW (self->overview),
+                                      one || (self->panels_taken == 0 && self->follows_panels));
+
+  phosh_layer_surface_get_margins (PHOSH_LAYER_SURFACE (self), &top, &right, &bottom, &left);
+  changed = left != want_left || right != want_right || one != self->on_one_panel;
+  if (changed && self->state == PHOSH_HOME_STATE_UNFOLDED && !self->reflow_ready) {
+    phosh_home_fade_out (self);
+    phosh_home_update_handle (self);
+    return;
+  }
+
+  if (changed) {
+    g_debug ("Home on %s", one ? (want_left ? "the right panel" : "the left panel") : "the whole display");
+    self->reflow_ready = FALSE;
+    self->on_one_panel = one;
+    phosh_home_hide_reflow (self);
+    phosh_util_toggle_style_class (GTK_WIDGET (self), "p-one-panel", one);
+    /* beside a window home needs no bar: the window and the wallpaper
+     * reach the bottom edge */
+    phosh_drag_surface_set_exclusive (PHOSH_DRAG_SURFACE (self), one ? 0 : PHOSH_HOME_BAR_HEIGHT);
+    phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), top, want_right, bottom, want_left);
+    /* the wallpaper home stands on goes with it: over its panel to the
+     * bottom edge, and not over the window beside it */
+    if (self->background) {
+      phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self->background), 0, want_right, 0, want_left);
+      phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (self->background));
+    }
+    if (self->state == PHOSH_HOME_STATE_UNFOLDED)
+      phosh_layer_surface_set_kbd_interactivity (PHOSH_LAYER_SURFACE (self), !one);
+    phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (self));
+  }
+
+  if (!one) {
+    self->desktop_wanted = FALSE;
+    phosh_home_update_handle (self);
+    return;
+  }
+
+  /* already standing there - unfolded when the window came up beside it */
+  if (self->state == PHOSH_HOME_STATE_UNFOLDED) {
+    self->desktop_wanted = FALSE;
+  } else if (self->desktop_wanted) {
+    self->desktop_wanted = FALSE;
+    phosh_home_set_state (self, PHOSH_HOME_STATE_UNFOLDED);
+  }
+  phosh_home_update_handle (self);
+}
+
+
+static void
+on_panels_taken (void *data, struct phosh_private *phosh_private, uint32_t panels)
+{
+  PhoshHome *self = PHOSH_HOME (data);
+  guint was = self->panels_taken;
+  gboolean was_one = was == 1 || was == 2;
+  gboolean is_one = panels == 1 || panels == 2;
+
+  g_debug ("Panels taken: %u", panels);
+  if (panels != self->panels_taken)
+    self->overview_forced = FALSE;
+  self->panels_taken = panels;
+  if (panels) {
+    self->expected_panel = 0;
+    g_clear_handle_id (&self->expected_id, g_source_remove);
+  }
+
+  /* a panel newly free gets its desktop; a desktop folded by hand stays so */
+  if (is_one && (!was_one || panels != was))
+    self->desktop_wanted = TRUE;
+
+  /* both panels newly taken: nothing left to stand on */
+  if (panels == 3 && was != 3 && self->state == PHOSH_HOME_STATE_UNFOLDED) {
+    phosh_home_set_state (self, PHOSH_HOME_STATE_FOLDED);
+    return;
+  }
+
+  phosh_home_sync_panels (self);
+}
+
+
+static const struct phosh_private_listener phosh_private_listener = {
+  .panels_taken = on_panels_taken,
+};
+
+
+/**
+ * phosh_home_follows_panels:
+ * @self: The home surface
+ *
+ * Whether home follows the panels windows stand on - a display with a seam
+ * and a compositor that says which are taken. Home then goes on standing
+ * when an app is started from it: the app's window takes its panel and home
+ * moves over to the other one instead of folding and unfolding again.
+ *
+ * Returns: %TRUE if home follows the panels
+ */
+gboolean
+phosh_home_follows_panels (PhoshHome *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  GdkRectangle seam;
+
+  g_return_val_if_fail (PHOSH_IS_HOME (self), FALSE);
+
+  return self->follows_panels &&
+    phosh_layout_manager_get_seam (phosh_shell_get_layout_manager (shell), &seam);
+}
+
+
+#define PHOSH_HOME_EXPECT_TIMEOUT_S 8
+
+static void
+on_animating_timeout (gpointer data)
+{
+  PhoshHome *self = PHOSH_HOME (data);
+
+  self->animating_id = 0;
+  self->animating = FALSE;
+  phosh_home_sync_panels (self);
+}
+
+static void
+on_expected_timeout (gpointer data)
+{
+  PhoshHome *self = PHOSH_HOME (data);
+
+  /* the app never came up: home back across the display */
+  g_debug ("No window on the expected panel");
+  self->expected_id = 0;
+  self->expected_panel = 0;
+  phosh_home_sync_panels (self);
+}
+
+
+static void
+phosh_home_expect_panel (PhoshHome *self, int launch_x)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  GdkRectangle seam;
+
+  if (launch_x < 0 ||
+      !phosh_layout_manager_get_seam (phosh_shell_get_layout_manager (shell), &seam))
+    return;
+
+  self->expected_panel = launch_x < seam.x ? 1 : 2;
+  g_clear_handle_id (&self->expected_id, g_source_remove);
+  self->expected_id = g_timeout_add_seconds_once (PHOSH_HOME_EXPECT_TIMEOUT_S,
+                                                  on_expected_timeout, self);
+  g_source_set_name_by_id (self->expected_id, "[phosh] home expected panel");
+  phosh_home_sync_panels (self);
+}
+
+
 static void
 phosh_home_set_property (GObject      *object,
                          guint         property_id,
@@ -301,6 +789,23 @@ fold_cb (PhoshHome *self, PhoshOverview *overview)
   g_return_if_fail (PHOSH_IS_HOME (self));
   g_return_if_fail (PHOSH_IS_OVERVIEW (overview));
 
+  /* a card chosen, or the overview left, from beside the desktop: the
+   * desktop comes back beside the window */
+  if (self->overview_forced) {
+    self->overview_forced = FALSE;
