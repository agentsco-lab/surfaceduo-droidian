+/**
+ * phosh_shell_get_launch_x:
+ *
+ * Where the launch of the last second came from. The splash takes its own
+ * copy (phosh_shell_take_launch_x) as the app starts, before anyone else
+ * hears of the launch; home reads this one afterwards.
+ *
+ * Returns: where the last launch came from if within the last second, or -1
+ */
+int
+phosh_shell_get_launch_x (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  if (g_get_monotonic_time () - priv->last_launch_time > G_USEC_PER_SEC)
+    return -1;
+
+  return priv->last_launch_x;
