From e5231b83f600544860ccf10021b395e28319561f Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Thu, 24 Sep 2026 22:27:22 +0300
Subject: [PATCH 04/10] shell: a full-height cutout is a seam - a top panel per
 half

On a display with a seam - a cutout running its whole height, which is
what a hinge between two halves looks like - the top panel is made once
per half, each with its own bar and its own shade, so that neither is cut
in two by the bezel. The layout manager says where the seam is.
---
 src/layout-manager.c |  72 +++++++++++++++++++++++
 src/layout-manager.h |   2 +
 src/shell.c          | 133 +++++++++++++++++++++++++++++++++++++++----
 src/top-panel.c      |  23 +++++++-
 src/top-panel.h      |   5 +-
 5 files changed, 221 insertions(+), 14 deletions(-)

diff --git a/src/layout-manager.c b/src/layout-manager.c
index a6187ac7..a5765db2 100644
--- a/src/layout-manager.c
+++ b/src/layout-manager.c
@@ -139,6 +139,19 @@ get_clock_pos (PhoshLayoutManager *self, guint *clock_box_shift)
       .height = ceil (bounds->height / scale),
     };
 
+    /* A cutout running the whole height of the panel is a seam, not a notch:
+     * a hinge between two halves of one display. Nothing about the top bar
+     * should move because of it - the shell gives such a display a bar per
+     * half instead, and each centres its own clock.
+     *
+     * Treating it as a notch was actively harmful: the shift below is applied
+     * as a top margin to the settings menu, and a cutout the full height of
+     * the display pushed the whole shade off the bottom of it. Pulling the
+     * shade down gave a black screen with nothing drawn in it at all.
+     */
+    if (notch.height >= self->builtin->height / scale)
+      continue;
+
     if (gdk_rectangle_intersect (&notch, &clock_box_rect, NULL))
       shift = MAX (shift, notch.height + notch.y);
 
@@ -487,3 +500,62 @@ phosh_layout_manager_get_box_shifts (PhoshLayoutManager *self,
   *indicators_shift = self->indicators_box_shift;
   *settings_shift = self->corner_shift;
 }
+
+
+/**
+ * phosh_layout_manager_get_seam:
+ * @self: The layout manager
+ * @seam: (out): The seam, in logical pixels
+ *
+ * A seam is a cutout that runs the whole height of the panel: a hinge
+ * between two halves of one display rather than a notch in the top of it.
+ * The Surface Duo has one, 84 physical pixels wide, dead in the middle.
+ *
+ * A shell that knows about it can treat the display as two, which is what
+ * the device looks like to the hand holding it.
+ *
+ * Returns: %TRUE if the display has a seam
+ */
+gboolean
+phosh_layout_manager_get_seam (PhoshLayoutManager *self, GdkRectangle *seam)
+{
+  GListModel *cutouts;
+  float scale;
+  int height;
+
+  g_return_val_if_fail (PHOSH_IS_LAYOUT_MANAGER (self), FALSE);
+  g_return_val_if_fail (seam, FALSE);
+
+  if (self->panel == NULL || self->builtin == NULL)
+    return FALSE;
+
+  if (g_settings_get_enum (self->settings, SHELL_LAYOUT_KEY) != PHOSH_SHELL_LAYOUT_DEVICE)
+    return FALSE;
+
+  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL)
+    return FALSE;
+
+  scale = phosh_monitor_get_fractional_scale (self->builtin);
+  height = self->builtin->height / scale;
+
+  cutouts = gm_display_panel_get_cutouts (self->panel);
+  for (int i = 0; i < g_list_model_get_n_items (cutouts); i++) {
+    g_autoptr (GmCutout) cutout = g_list_model_get_item (cutouts, i);
+    const GmRect *bounds = gm_cutout_get_bounds (cutout);
+    GdkRectangle rect = {
+      .x = floor (bounds->x / scale),
+      .y = floor (bounds->y / scale),
+      .width = ceil (bounds->width / scale),
+      .height = ceil (bounds->height / scale),
+    };
+
+    if (rect.height < height || rect.width >= self->builtin->width / scale)
+      continue;
+
+    *seam = rect;
+    g_debug ("Display has a seam at %d, %d wide", rect.x, rect.width);
+    return TRUE;
+  }
+
+  return FALSE;
+}
diff --git a/src/layout-manager.h b/src/layout-manager.h
index 36c9a912..3eb450b5 100644
--- a/src/layout-manager.h
+++ b/src/layout-manager.h
@@ -25,4 +25,6 @@ void                         phosh_layout_manager_get_box_shifts       (PhoshLay
                                                                         guint *network_shift,
                                                                         guint *indicators_shift,
                                                                         guint *settings_shift);
+gboolean                     phosh_layout_manager_get_seam             (PhoshLayoutManager *self,
+                                                                        GdkRectangle *seam);
 G_END_DECLS
diff --git a/src/shell.c b/src/shell.c
index 2987a0c2..a231089d 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -144,6 +144,10 @@ static PhoshShellDebugFlags debug_flags;
 
 typedef struct {
   PhoshDragSurface           *top_panel;
+  /* On a display with a seam down it, the panel for the far half. The
+   * two are independent: each folds, unfolds and drags on its own, so
+   * each half of the device has its own shade. NULL otherwise. */
+  PhoshDragSurface           *top_panel_right;
   PhoshDragSurface           *home;
   gboolean                    overview_visible;
   GPtrArray                  *faders; /* for final fade out */
@@ -237,10 +241,10 @@ static void
 on_top_panel_activated (PhoshShell    *self,
                         PhoshTopPanel *window)
 {
-  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
-
-  g_return_if_fail (PHOSH_IS_TOP_PANEL (priv->top_panel));
-  phosh_top_panel_toggle_fold (PHOSH_TOP_PANEL (priv->top_panel));
+  /* The panel that was touched, not the first one: with a panel per half
+   * they have to answer for themselves. */
+  g_return_if_fail (PHOSH_IS_TOP_PANEL (window));
+  phosh_top_panel_toggle_fold (window);
 }
 
 
@@ -277,6 +281,8 @@ update_top_level_layer (PhoshShell *self)
 
   g_debug ("Moving top-panel to %s layer", use_top_layer ? "top" : "overlay");
   phosh_top_panel_set_layer (PHOSH_TOP_PANEL (priv->top_panel), layer);
+  if (priv->top_panel_right)
+    phosh_top_panel_set_layer (PHOSH_TOP_PANEL (priv->top_panel_right), layer);
 }
 
 
@@ -305,9 +311,34 @@ on_top_panel_state_changed (PhoshShell *self, GParamSpec *pspec, PhoshTopPanel *
   priv = phosh_shell_get_instance_private (self);
 
   state = phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel));
+  if (state != PHOSH_TOP_PANEL_STATE_UNFOLDED && priv->top_panel_right)
+    state = phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel_right));
   phosh_shell_set_state (self, PHOSH_STATE_SETTINGS, state == PHOSH_TOP_PANEL_STATE_UNFOLDED);
 }
 
+/* Whether every top panel is folded away. With a panel per half of the
+ * display, "the shade is closed" means both of them are. */
+static gboolean
+phosh_shell_top_panels_folded (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  if (!priv->top_panel)
+    return TRUE;
+
+  if (phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel)) !=
+      PHOSH_TOP_PANEL_STATE_FOLDED)
+    return FALSE;
+
+  if (priv->top_panel_right &&
+      phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel_right)) !=
+      PHOSH_TOP_PANEL_STATE_FOLDED)
+    return FALSE;
+
+  return TRUE;
+}
+
+
 static void
 update_top_bar_transparency (PhoshShell *self)
 {
@@ -319,12 +350,18 @@ update_top_bar_transparency (PhoshShell *self)
 
   if (priv->locked) {
     phosh_top_panel_set_bar_transparent (PHOSH_TOP_PANEL (priv->top_panel), TRUE);
+    if (priv->top_panel_right)
+      phosh_top_panel_set_bar_transparent (PHOSH_TOP_PANEL (priv->top_panel_right), TRUE);
     return;
   }
 
   state = phosh_home_get_state (PHOSH_HOME (priv->home));
   phosh_top_panel_set_bar_transparent (PHOSH_TOP_PANEL (priv->top_panel),
                                        (state != PHOSH_HOME_STATE_FOLDED));
+  if (priv->top_panel_right) {
+    phosh_top_panel_set_bar_transparent (PHOSH_TOP_PANEL (priv->top_panel_right),
+                                         (state != PHOSH_HOME_STATE_FOLDED));
+  }
 }
 
 
@@ -371,6 +408,11 @@ on_primary_monitor_configured (PhoshShell *self, PhoshMonitor *monitor)
 
   phosh_shell_get_area (self, NULL, &height);
   phosh_layer_surface_set_size (PHOSH_LAYER_SURFACE (priv->top_panel), -1, height);
+  /* The far half is a panel like any other and needs the same height. A
+   * shade is as tall as the surface it unfolds inside; left at the bar's own
+   * height, that one opened a finger's width and stopped there. */
+  if (priv->top_panel_right)
+    phosh_layer_surface_set_size (PHOSH_LAYER_SURFACE (priv->top_panel_right), -1, height);
 }
 
 
@@ -405,18 +447,71 @@ panels_create (PhoshShell *self)
   PhoshMonitor *monitor;
   PhoshAppGrid *app_grid;
   guint32 top_layer;
+  GdkRectangle seam;
 
   monitor = phosh_shell_get_primary_monitor (self);
   g_return_if_fail (monitor);
 
   top_layer = priv->locked ? ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY : ZWLR_LAYER_SHELL_V1_LAYER_TOP;
 
-  /* Top panel */
-  priv->top_panel = PHOSH_DRAG_SURFACE (phosh_top_panel_new (
-                                          phosh_wayland_get_zwlr_layer_shell_v1 (wl),
-                                          phosh_wayland_get_zphoc_layer_shell_effects_v1 (wl),
-                                          monitor,
-                                          top_layer));
+  /* Top panel. A display with a seam - a cutout running its whole height,
+   * which is what a hinge between two halves looks like - gets one panel per
+   * half, each with its own bar and its own shade, so that neither is cut in
+   * two by the bezel and either half can be pulled down on its own.
+   *
+   * Both stay anchored to three edges - phoc will not make a surface
+   * draggable otherwise - and reach only their own half by leaving a margin
+   * on the side of the seam they do not belong to.
+   *
+   * The near one reserves the bar's height, the far one a single pixel.
+   * The zones of surfaces anchored to the same edge are added up, so the far
+   * one has to claim almost nothing - but not nothing at all. phoc keeps a
+   * dragged surface's zone at its reservation less the margin it is folded
+   * by, so a panel that reserved nothing reached zero the moment its shade
+   * was fully unfolded, and phoc draws every surface whose zone is zero or
+   * less underneath every surface whose zone is positive. The far half's
+   * shade opened behind its own dimming surface: it was there, drawing, and
+   * the half was black. One pixel keeps it on the near panel's side of that
+   * line. It costs one logical pixel of the display's top and leaves the two
+   * halves of the bar two physical pixels out of line, which is measured and
+   * not visible. */
+  if (phosh_layout_manager_get_seam (priv->layout_manager, &seam)) {
+    int past_seam = seam.x + seam.width;
+
+    g_debug ("Seam at %d, %d wide: a top panel per half", seam.x, seam.width);
+    priv->top_panel = PHOSH_DRAG_SURFACE (phosh_top_panel_new (
+                                            phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                                            phosh_wayland_get_zphoc_layer_shell_effects_v1 (wl),
+                                            monitor,
+                                            top_layer,
+                                            0,
+                                            monitor->logical.width - seam.x,
+                                            PHOSH_TOP_BAR_HEIGHT));
+    priv->top_panel_right = PHOSH_DRAG_SURFACE (phosh_top_panel_new (
+                                                  phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                                                  phosh_wayland_get_zphoc_layer_shell_effects_v1 (wl),
+                                                  monitor,
+                                                  top_layer,
+                                                  past_seam,
+                                                  0,
+                                                  1));
+    /* The far half is marked so a stylesheet can tell the two apart. Both
+     * bars carry the same clock and the same indicators, and side by side
+     * that reads as one bar drawn twice rather than as two halves; the port
+     * hides this one's contents and keeps it as a handle for its own shade. */
+    gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (priv->top_panel_right)),
+                                 "phosh-far-half");
+    gtk_widget_set_visible (GTK_WIDGET (priv->top_panel_right), TRUE);
+  } else {
+    priv->top_panel = PHOSH_DRAG_SURFACE (phosh_top_panel_new (
+                                            phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                                            phosh_wayland_get_zphoc_layer_shell_effects_v1 (wl),
+                                            monitor,
+                                            top_layer,
+                                            0,
+                                            0,
+                                            PHOSH_TOP_BAR_HEIGHT));
+  }
   gtk_widget_set_visible (GTK_WIDGET (priv->top_panel), TRUE);
 
   /* Home is created after the top-panel so it honors its exclusive zone */
@@ -435,6 +530,17 @@ panels_create (PhoshShell *self)
                             G_CALLBACK (on_top_panel_state_changed),
                             self);
 
+  if (priv->top_panel_right) {
+    g_signal_connect_swapped (priv->top_panel_right,
+                              "activated",
+                              G_CALLBACK (on_top_panel_activated),
+                              self);
+    g_signal_connect_swapped (priv->top_panel_right,
+                              "notify::state",
+                              G_CALLBACK (on_top_panel_state_changed),
+                              self);
+  }
+
   g_signal_connect_swapped (priv->home,
                             "notify::state",
                             G_CALLBACK (on_home_state_changed),
@@ -454,6 +560,7 @@ panels_dispose (PhoshShell *self)
 {
   PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
 
+  g_clear_pointer (&priv->top_panel_right, phosh_cp_widget_destroy);
   g_clear_pointer (&priv->top_panel, phosh_cp_widget_destroy);
   g_clear_pointer (&priv->home, phosh_cp_widget_destroy);
 }
@@ -475,6 +582,8 @@ set_locked (PhoshShell *self, gboolean locked)
      unblanking the screen which can be confusing */
   if (priv->top_panel)
     phosh_top_panel_fold (PHOSH_TOP_PANEL (priv->top_panel));
+  if (priv->top_panel_right)
+    phosh_top_panel_fold (PHOSH_TOP_PANEL (priv->top_panel_right));
 
   update_top_level_layer (self);
   update_top_bar_transparency (self);
@@ -711,7 +820,7 @@ on_new_notification (PhoshShell         *self,
   /* Clear existing banner */
   g_clear_pointer (&priv->notification_banner, phosh_cp_widget_destroy);
   if (phosh_notify_manager_get_show_notification_banner (manager, notification) &&
-      phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel)) == PHOSH_TOP_PANEL_STATE_FOLDED &&
+      phosh_shell_top_panels_folded (self) &&
       !priv->locked) {
     priv->notification_banner = phosh_notification_banner_new (notification);
     g_signal_connect (priv->notification_banner,
@@ -743,6 +852,8 @@ on_notification_activated (PhoshShell *self)
   priv = phosh_shell_get_instance_private (self);
 
   phosh_top_panel_fold (PHOSH_TOP_PANEL (priv->top_panel));
+  if (priv->top_panel_right)
+    phosh_top_panel_fold (PHOSH_TOP_PANEL (priv->top_panel_right));
 }
 
 
diff --git a/src/top-panel.c b/src/top-panel.c
index 974e8008..5f37ae74 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -601,6 +601,15 @@ static void
 phosh_top_panel_map (GtkWidget *widget)
 {
   PhoshTopPanel *self = PHOSH_TOP_PANEL (widget);
+  int margin_left, margin_right;
+
+  /* The background reaches exactly as far as the panel it belongs to, or it
+   * dims the other half of a split display along with its own. Here and not
+   * where the background is made: the margins are ordinary properties and
+   * GObject applies those after constructed() has run, so asking for them
+   * there returns zero. */
+  g_object_get (self, "margin-left", &margin_left, "margin-right", &margin_right, NULL);
+  g_object_set (self->background, "margin-left", margin_left, "margin-right", margin_right, NULL);
 
   GTK_WIDGET_CLASS (phosh_top_panel_parent_class)->map (widget);
 
@@ -1083,13 +1092,23 @@ GtkWidget *
 phosh_top_panel_new (struct zwlr_layer_shell_v1          *layer_shell,
                      struct zphoc_layer_shell_effects_v1 *layer_shell_effects,
                      PhoshMonitor                        *monitor,
-                     guint32                              layer)
+                     guint32                              layer,
+                     int                                  margin_left,
+                     int                                  margin_right,
+                     int                                  exclusive)
 {
+  /* Anchored to three edges, always: phoc refuses to make a layer surface
+   * draggable otherwise ("Surface not anchored to three edges"), and the
+   * shade is a dragged surface. A panel that covers half the display gets
+   * there by leaving a margin on the side it does not reach, not by letting
+   * go of an anchor. */
   return g_object_new (PHOSH_TYPE_TOP_PANEL,
                        /* layer-surface */
                        "layer-shell", layer_shell,
                        "wl-output", monitor->wl_output,
                        "height", PHOSH_TOP_BAR_HEIGHT,
+                       "margin-left", margin_left,
+                       "margin-right", margin_right,
                        "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
                                  ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
                                  ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
@@ -1098,7 +1117,7 @@ phosh_top_panel_new (struct zwlr_layer_shell_v1          *layer_shell,
                        "namespace", "phosh top-panel",
                        /* drag-surface */
                        "layer-shell-effects", layer_shell_effects,
-                       "exclusive", PHOSH_TOP_BAR_HEIGHT,
+                       "exclusive", exclusive,
                        "threshold", PHOSH_TOP_PANEL_DRAG_THRESHOLD,
                        NULL);
 }
diff --git a/src/top-panel.h b/src/top-panel.h
index 1e4748ad..33253f69 100644
--- a/src/top-panel.h
+++ b/src/top-panel.h
@@ -33,7 +33,10 @@ typedef enum {
 GtkWidget         *phosh_top_panel_new (struct zwlr_layer_shell_v1          *layer_shell,
                                         struct zphoc_layer_shell_effects_v1 *layer_shell_effects,
                                         PhoshMonitor                        *monitor,
-                                        guint32                              layer);
+                                        guint32                              layer,
+                                        int                                  margin_left,
+                                        int                                  margin_right,
+                                        int                                  exclusive);
 void               phosh_top_panel_toggle_fold (PhoshTopPanel *self);
 void               phosh_top_panel_fold (PhoshTopPanel *self);
 void               phosh_top_panel_unfold (PhoshTopPanel *self);
