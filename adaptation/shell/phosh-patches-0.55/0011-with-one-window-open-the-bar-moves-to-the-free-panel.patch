 void               phosh_top_panel_set_bar_transparent (PhoshTopPanel *self, gboolean transparent);
 void               phosh_top_panel_set_half (PhoshTopPanel *self, PhoshSettingsHalf half);
+
+/**
+ * PhoshTopBarMode:
+ * @PHOSH_TOP_BAR_MODE_HALF: this half's share of the bar (see gtk.css)
