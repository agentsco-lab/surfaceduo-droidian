+  margin = get_margin (self, event->height);
 
   /* ignore popovers like the power menu */
   if (gtk_widget_get_window (GTK_WIDGET (self)) != event->window)
@@ -1216,3 +1221,39 @@ phosh_top_panel_set_half (PhoshTopPanel *self, PhoshSettingsHalf half)
   gtk_widget_set_child_visible (self->btn_lock, half != PHOSH_SETTINGS_HALF_FAR);
   gtk_widget_set_child_visible (self->btn_power, half != PHOSH_SETTINGS_HALF_FAR);
 }
+
+
+/**
+ * phosh_top_panel_set_bar_mode:
+ * @self: The top panel
+ * @mode: What the folded bar shows
+ *
+ * On a display with a seam and one window on one half, the bar of that half
+ * folds up out of sight, but for a handle its shade can still be pulled by,
+ * and the other half's bar shows all of it: the window gets the height of
+ * its panel. The bar's contents follow a style class each mode sets
+ * (phosh-bar-all, phosh-bar-none); the fold is a change of the folded
+ * margin, which the compositor slides the surface to.
+ */
+void
+phosh_top_panel_set_bar_mode (PhoshTopPanel *self, PhoshTopBarMode mode)
+{
+  int height;
+
+  g_return_if_fail (PHOSH_IS_TOP_PANEL (self));
+
+  if (self->bar_mode == mode)
+    return;
+  self->bar_mode = mode;
+
+  phosh_util_toggle_style_class (GTK_WIDGET (self), "phosh-bar-all", mode == PHOSH_TOP_BAR_MODE_ALL);
+  phosh_util_toggle_style_class (GTK_WIDGET (self), "phosh-bar-none", mode == PHOSH_TOP_BAR_MODE_NONE);
+
+  height = phosh_layer_surface_get_configured_height (PHOSH_LAYER_SURFACE (self));
+  if (height <= 0)
+    return;                     /* the first configure sets the margin */
+
+  phosh_drag_surface_set_margin (PHOSH_DRAG_SURFACE (self), get_margin (self, height), 0);
+  update_drag_handle (self, FALSE);
+  phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (self));
+}
