+/* {{{ No status bar */
+/*
+ * Outside the lock screen the bar is folded to its handle on both halves
+ * (#95, #96): its icons sat in the same pixels of an AMOLED panel all day,
+ * and its height was taken from every window on either panel. A shade is
+ * still pulled down by either handle, and the far one shows the clock and
+ * the date. The lock screen keeps its bar - it is lit to be glanced at - and
+ * so does a shell without the dock (org.sfduo.Dock), whose desktop is where
+ * the time is shown instead.
+ */
+static void
+update_bar_modes (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshTopBarMode mode = PHOSH_TOP_BAR_MODE_HALF;
+  g_autofree char *owner = NULL;
+  guint exclusive = PHOSH_TOP_BAR_HEIGHT;
+
+  if (priv->top_panel == NULL || priv->top_panel_right == NULL)
+    return;
+
+  if (priv->dock_proxy && !priv->locked)
+    owner = g_dbus_proxy_get_name_owner (priv->dock_proxy);
+  if (owner) {
+    mode = PHOSH_TOP_BAR_MODE_NONE;
+    exclusive = 1;
+  }
+
+  phosh_top_panel_set_bar_mode (PHOSH_TOP_PANEL (priv->top_panel), mode);
+  phosh_top_panel_set_bar_mode (PHOSH_TOP_PANEL (priv->top_panel_right), mode);
+  if (priv->bar_exclusive != exclusive) {
+    priv->bar_exclusive = exclusive;
+    phosh_drag_surface_set_exclusive (priv->top_panel, exclusive);
+    phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (priv->top_panel));
+  }
+}
+
+
+static void
+on_dock_proxy_ready (GObject *source, GAsyncResult *res, gpointer data)
+{
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+  PhoshShell *self;
+  PhoshShellPrivate *priv;
+
+  if (proxy == NULL) {
+    g_debug ("No dock proxy: %s", err->message);
+    return;
+  }
+  self = PHOSH_SHELL (data);
+  priv = phosh_shell_get_instance_private (self);
+  priv->dock_proxy = proxy;
+  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (update_bar_modes), self,
+                           G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (update_bar_modes), self,
+                           G_CONNECT_SWAPPED);
+  update_bar_modes (self);
+}
+
+
+static void
+dock_watch_start (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  static gboolean started;
+
+  if (started || priv->top_panel_right == NULL)
+    return;
+  started = TRUE;
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL,
+                            "org.sfduo.Dock", "/org/sfduo/Dock", "org.sfduo.Dock",
+                            NULL, on_dock_proxy_ready, self);
+}
+/* }}} */
+
+
 static void
 set_locked (PhoshShell *self, gboolean locked)
 {
@@ -728,6 +814,7 @@ set_locked (PhoshShell *self, gboolean locked)
 
   update_top_level_layer (self);
   update_top_bar_transparency (self);
+  update_bar_modes (self);
 }
 
 
