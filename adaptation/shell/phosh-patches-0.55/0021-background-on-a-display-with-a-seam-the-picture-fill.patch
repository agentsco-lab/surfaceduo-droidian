From 09400abd4d8bac167c9bfed7f62bf887adb0167d Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <ivanverbovoy@gmail.com>
Date: Sat, 26 Sep 2026 01:49:33 +0300
Subject: [PATCH] background: on a display with a seam the picture fills the
 surface

The primary background drew its picture into the shell's usable area, which
leaves out the top bar's and the home bar's height. On a display with a seam
the port folds the bar out of sight outside the lock screen and there is no
home bar, so the wallpaper stopped 32 px below the top and 15 px above the
bottom, the strips painted in the CSS colour: a black band over it (#208).
---
 src/background.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/background.c b/src/background.c
index 19245c90..124a00a1 100644
--- a/src/background.c
+++ b/src/background.c
@@ -19,6 +19,7 @@
 #include "background-image.h"
 #include "background-manager.h"
 #include "layersurface-priv.h"
+#include "layout-manager.h"
 #include "shell-priv.h"
 #include "top-panel.h"
 #include "util.h"
@@ -198,6 +199,23 @@ image_background (PhoshBackgroundImage    *image,
 }
 
 
+/*
+ * On a display with a seam the top bar is folded out of sight outside the lock
+ * screen and there is no home bar, so the primary background's picture is
+ * not kept out of their strips: it fills the surface. Drawn into the usable
+ * area it left the bar's height at the top and the home bar's at the bottom
+ * in the CSS colour - a black band over the wallpaper.
+ */
+static gboolean
+fills_output (void)
+{
+  GdkRectangle seam;
+
+  return phosh_layout_manager_get_seam (phosh_shell_get_layout_manager (phosh_shell_get_default ()),
+                                        &seam);
+}
+
+
 static gboolean
 phosh_background_draw (GtkWidget *widget, cairo_t *cr)
 {
@@ -209,7 +227,7 @@ phosh_background_draw (GtkWidget *widget, cairo_t *cr)
   if (!self->configured)
     return GDK_EVENT_PROPAGATE;
 
-  if (self->primary)
+  if (self->primary && !fills_output ())
     phosh_shell_get_usable_area (phosh_shell_get_default (), &x, &y, NULL, NULL);
 
   cairo_save (cr);
@@ -245,7 +263,7 @@ update_image (PhoshBackground *self)
   if (!self->configured)
     return;
 
-  if (self->primary) {
+  if (self->primary && !fills_output ()) {
     phosh_shell_get_usable_area (phosh_shell_get_default (), NULL, NULL, &width, &height);
   } else {
     width = phosh_layer_surface_get_configured_width (PHOSH_LAYER_SURFACE (self));
-- 
