From 7cadd3ebd88416bc195f61d2d1dec4d200185ee8 Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <ivanverbovoy@gmail.com>
Date: Fri, 25 Sep 2026 02:51:45 +0300
Subject: [PATCH] osk: on a two-panel display, the keyboard goes to the panel
 of the window typed into

The dock places every window on a panel and says where (org.sfduo.Dock, Placed). Each time the keyboard comes up, and when the active window changes while it is up, it takes the panel of the active window, by its left margin; a window the dock did not place leaves it on the right panel. Its exclusive zone goes with the start of the slide rather than its end: the compositor makes the windows on that panel shorter by it (phoc-patches/0020), once, so a field at a window's bottom goes up as the keyboard comes in under it.
---
 src/phosh-osk-stevia.c      | 82 +++++++++++++++++++++++++++++++++++--
 src/pos-activation-filter.c | 22 ++++++++++
 src/pos-activation-filter.h |  1 +
 src/pos-input-surface.c     | 40 ++++++++++++++++--
 src/pos-input-surface.h     |  1 +
 5 files changed, 139 insertions(+), 7 deletions(-)

diff --git a/src/phosh-osk-stevia.c b/src/phosh-osk-stevia.c
index 462ff67..911888b 100644
--- a/src/phosh-osk-stevia.c
+++ b/src/phosh-osk-stevia.c
@@ -57,6 +57,11 @@ typedef struct _PosApp {
   PosEmojiDb          *emoji_db;
   PosSizeManager      *size_manager;
   int                  exit_status;
+  /* A display with a seam: one panel's width and the hinge's, and the dock
+   * that knows which panel each window is on (org.sfduo.Dock) */
+  int                  panel;
+  int                  gap;
+  GDBusProxy          *dock;
 } PosApp;
 
 G_DEFINE_TYPE (PosApp, pos_app, G_TYPE_OBJECT)
@@ -190,6 +195,8 @@ pos_app_session_register (PosApp *self, const char *client_id)
 }
 
 
+static void follow_active_window (PosApp *self);
+
 static gboolean
 set_surface_prop_surface_visible (GBinding     *binding,
                                   const GValue *from_value,
@@ -215,6 +222,8 @@ set_surface_prop_surface_visible (GBinding     *binding,
   g_debug ("active: %d, enabled: %d", visible, enabled);
   if (enabled == FALSE)
     visible = FALSE;
+  if (visible)
+    follow_active_window (self);
 
   g_value_set_boolean (to_value, visible);
 
@@ -314,6 +323,59 @@ panel_width_for_seam (void)
   return (geom.width - (int) (seam * geom.width + 0.5)) / 2;
 }
 
+
+static int
+output_width (void)
+{
+  GdkDisplay *display = gdk_display_get_default ();
+  GdkMonitor *monitor = gdk_display_get_primary_monitor (display);
+  GdkRectangle geom = { 0 };
+
+  if (!monitor)
+    monitor = gdk_display_get_monitor (display, 0);
+  if (monitor)
+    gdk_monitor_get_geometry (monitor, &geom);
+  return geom.width;
+}
+
+
+/*
+ * The keyboard goes on the panel of the window being typed into: the dock
+ * places every window on a panel and says where (org.sfduo.Dock, Placed).
+ * A window it has not placed - or no dock - leaves it on the right panel,
+ * under the thumb, as before.
+ */
+static void
+follow_active_window (PosApp *self)
+{
+  const char *app_id, *side = NULL;
+  g_autoptr (GVariant) placed = NULL;
+
+  if (!self->panel || !self->input_surface)
+    return;
+
+  app_id = self->activation_filter ?
+    pos_activation_filter_get_active_app_id (self->activation_filter) : NULL;
+  if (app_id && self->dock)
+    placed = g_dbus_proxy_get_cached_property (self->dock, "Placed");
+  if (placed)
+    g_variant_lookup (placed, app_id, "&s", &side);
+
+  g_debug ("Keyboard for %s: the %s panel", app_id ?: "(none)",
+           g_strcmp0 (side, "left") == 0 ? "left" : "right");
+  pos_input_surface_set_margin_left (self->input_surface,
+                                     g_strcmp0 (side, "left") == 0 ? 0 : self->panel + self->gap);
+}
+
+static void
+on_active_window_changed (PosApp *self)
+{
+  /* the keyboard up, and the hand gone to a window on the other panel */
+  if (self->input_surface && pos_input_surface_get_visible (self->input_surface))
+    follow_active_window (self);
+}
+
+
 static void
 create_input_surface (PosApp *self)
 {
@@ -353,9 +415,15 @@ create_input_surface (PosApp *self)
      * the panels' density), so 50 px rows come out a fifth lower than a
      * thumb wants and 60 puts them back: four rows of 60. */
     height = SFDUO_KEY_ROW * 4;
-    g_debug ("Two-panel display: keyboard on the right panel, %d px wide, %u px high",
-             panel, height);
+    self->gap = output_width () - 2 * panel;
+    if (!self->dock)
+      self->dock = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SESSION,
+                                                  G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                                                  NULL, "org.sfduo.Dock", "/org/sfduo/Dock",
+                                                  "org.sfduo.Dock", NULL, NULL);
+    g_debug ("Two-panel display: keyboard one panel wide, %d px, %u px high", panel, height);
   }
+  self->panel = panel;
   self->input_surface = g_object_new (POS_TYPE_INPUT_SURFACE,
                                       "min-height", height,
                                       /* layer-surface */
@@ -364,7 +432,7 @@ create_input_surface (PosApp *self)
                                       "width", panel,
                                       "anchor", panel ?
                                       (ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
-                                       ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT) :
+                                       ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT) :
                                       (ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
                                        ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
                                        ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT),
@@ -400,6 +468,13 @@ create_input_surface (PosApp *self)
                             "min-height",
                             G_BINDING_SYNC_CREATE);
   }
+  if (panel) {
+    pos_input_surface_set_margin_left (self->input_surface, panel + self->gap);
+    if (self->activation_filter)
+      g_signal_connect_object (self->activation_filter, "active-changed",
+                               G_CALLBACK (on_active_window_changed), self,
+                               G_CONNECT_SWAPPED);
+  }
   g_object_bind_property (self->size_manager,
                           "dead-zone",
                           self->input_surface,
@@ -539,6 +614,7 @@ pos_input_surface_finalize (GObject *object)
 
   g_clear_object (&self->osk_dbus);
   g_clear_object (&self->activation_filter);
+  g_clear_object (&self->dock);
   g_clear_object (&self->hw_tracker);
 
   g_clear_object (&self->session_proxy);
diff --git a/src/pos-activation-filter.c b/src/pos-activation-filter.c
index f266fd0..fdd511c 100644
--- a/src/pos-activation-filter.c
+++ b/src/pos-activation-filter.c
@@ -30,6 +30,12 @@ enum {
 };
 static GParamSpec *props[PROP_LAST_PROP];
 
+enum {
+  ACTIVE_CHANGED,
+  N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
 typedef struct _PosToplevel PosToplevel;
 
 struct _PosActivationFilter {
@@ -64,6 +70,7 @@ pos_activation_filter_update_active (PosActivationFilter *self, PosToplevel *act
 {
   self->allow_active = TRUE;
   self->active = active;
+  g_signal_emit (self, signals[ACTIVE_CHANGED], 0);
 
   if (!self->active || !self->active->app_id)
     return;
@@ -344,6 +351,21 @@ pos_activation_filter_class_init (PosActivationFilterClass *klass)
                           G_PARAM_STATIC_STRINGS);
 
   g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+
+  /* The active window changed: the keyboard may belong on another panel */
+  signals[ACTIVE_CHANGED] = g_signal_new ("active-changed",
+                                          G_TYPE_FROM_CLASS (klass),
+                                          G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL,
+                                          G_TYPE_NONE, 0);
+}
+
+
+const char *
+pos_activation_filter_get_active_app_id (PosActivationFilter *self)
+{
+  g_return_val_if_fail (POS_IS_ACTIVATION_FILTER (self), NULL);
+
+  return self->active ? self->active->app_id : NULL;
 }
 
 
diff --git a/src/pos-activation-filter.h b/src/pos-activation-filter.h
index 1392ad6..2991b6c 100644
--- a/src/pos-activation-filter.h
+++ b/src/pos-activation-filter.h
@@ -14,3 +14,4 @@ G_DECLARE_FINAL_TYPE (PosActivationFilter, pos_activation_filter, POS, ACTIVATIO
 
 PosActivationFilter *pos_activation_filter_new                    (gpointer foreign_toplevel_management);
 gboolean             pos_activation_filter_allow_active           (PosActivationFilter *self);
+const char          *pos_activation_filter_get_active_app_id      (PosActivationFilter *self);
diff --git a/src/pos-input-surface.c b/src/pos-input-surface.c
index d9ebf7f..c87b69a 100644
--- a/src/pos-input-surface.c
+++ b/src/pos-input-surface.c
@@ -107,6 +107,8 @@ struct _PosInputSurface {
 
   gboolean                 surface_visible;
   PosInputSurfaceAnimation animation;
+  int                      margin_left;   /* which panel, on a display with a seam */
+  gboolean                 zone_early;    /* ... where the zone goes with the slide's start */
   guint                    min_height;
   guint                    dead_zone;
 
@@ -1076,10 +1078,14 @@ pos_input_surface_move (PosInputSurface *self)
   g_object_get (self, "configured-height", &height, NULL);
   margin = -height * progress;
 
-  phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), 0, 0, margin, 0);
+  phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), 0, 0, margin, self->margin_left);
 
-  if (self->animation.progress >= 1.0 && self->animation.show) {
-    /* On unfold adjust the exclusive zone at the very end to avoid flickering */
+  if (self->animation.show && (self->animation.progress >= 1.0 || self->zone_early)) {
+    /* On unfold adjust the exclusive zone at the very end to avoid flickering.
+     * On a display with a seam it goes at the start: the compositor makes the
+     * windows on the keyboard's panel shorter by it, and they are resized
+     * once, as the keyboard starts - a field at a window's bottom goes up as
+     * the keyboard comes in under it, rather than jumping up after it. */
     phosh_layer_surface_set_exclusive_zone (PHOSH_LAYER_SURFACE (self), height);
   } else if (self->animation.progress <= 0.0 && !self->animation.show) {
     /* On fold adjust the exclusive zone at the start to avoid flickering */
@@ -1783,7 +1789,8 @@ pos_input_surface_check_resize (GtkContainer *container)
 
   /* Ensure unfold animation starts from the screen bottom */
   if (G_APPROX_VALUE (self->animation.progress, 0.0, DBL_EPSILON))
-    phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), 0, 0, -min.height, 0);
+    phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), 0, 0, -min.height,
+                                     self->margin_left);
 
   GTK_CONTAINER_CLASS (pos_input_surface_parent_class)->check_resize (container);
 }
@@ -2321,6 +2328,31 @@ animation_timeout_cb (gpointer data)
 }
 
 
+/**
+ * pos_input_surface_set_margin_left:
+ * @self: The input surface
+ * @margin_left: The distance from the output's left edge
+ *
+ * On a display made of two panels the keyboard is one panel wide and stands
+ * on the panel of the window being typed into; this is where that panel
+ * starts. Applied at once if the keyboard is on screen, else when it next
+ * comes up.
+ */
+void
+pos_input_surface_set_margin_left (PosInputSurface *self, int margin_left)
+{
+  g_return_if_fail (POS_IS_INPUT_SURFACE (self));
+
+  self->zone_early = TRUE;
+  if (self->margin_left == margin_left)
+    return;
+
+  self->margin_left = margin_left;
+  if (gtk_widget_get_mapped (GTK_WIDGET (self)))
+    pos_input_surface_move (self);
+}
+
+
 void
 pos_input_surface_set_visible (PosInputSurface *self, gboolean visible)
 {
diff --git a/src/pos-input-surface.h b/src/pos-input-surface.h
index fd1fea1..e6f8cf6 100644
--- a/src/pos-input-surface.h
+++ b/src/pos-input-surface.h
@@ -15,6 +15,7 @@ G_BEGIN_DECLS
 G_DECLARE_FINAL_TYPE (PosInputSurface, pos_input_surface, POS, INPUT_SURFACE, PhoshLayerSurface)
 
 void     pos_input_surface_set_visible     (PosInputSurface *self, gboolean visible);
+void     pos_input_surface_set_margin_left (PosInputSurface *self, int margin_left);
 gboolean pos_input_surface_get_visible     (PosInputSurface *self);
 gboolean pos_input_surface_get_im_active   (PosInputSurface *self);
 gboolean pos_input_surface_get_active      (PosInputSurface *self);
-- 
