From 97f59bbc7e90a80f292ed08a207c09c0667c5a41 Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <ivanverbovoy@gmail.com>
Date: Fri, 25 Sep 2026 03:24:57 +0300
Subject: [PATCH] osk: the slide runs on a timer of its own

GTK's frame clock only advances on the compositor's frame callbacks, which a surface parked below the screen's edge does not get: the first slide after a start stood still until the one-second safety timeout put the keyboard in place in one step, and every show added a tick callback beside those still running. One timer, the same curve and length, reversed where it stands - the keyboard can be sent up and down as fast as the power button is pressed. On a display with a seam it is also shown by a request (sm.puri.OSK0), and goes to the active window's panel then too.
---
 src/phosh-osk-stevia.c  | 13 +++++++++++++
 src/pos-input-surface.c | 33 +++++++++++++++++++++++++--------
 2 files changed, 38 insertions(+), 8 deletions(-)

diff --git a/src/phosh-osk-stevia.c b/src/phosh-osk-stevia.c
index 911888b..5465ffe 100644
--- a/src/phosh-osk-stevia.c
+++ b/src/phosh-osk-stevia.c
@@ -367,6 +367,17 @@ follow_active_window (PosApp *self)
                                      g_strcmp0 (side, "left") == 0 ? 0 : self->panel + self->gap);
 }
 
+static void
+on_surface_visible (PosApp *self)
+{
+  /* shown by a request (sm.puri.OSK0 - phosh's power button on a folding
+   * display) rather than by a field: it goes to the active window's panel
+   * all the same */
+  if (self->input_surface && pos_input_surface_get_visible (self->input_surface))
+    follow_active_window (self);
+}
+
+
 static void
 on_active_window_changed (PosApp *self)
 {
@@ -470,6 +481,8 @@ create_input_surface (PosApp *self)
   }
   if (panel) {
     pos_input_surface_set_margin_left (self->input_surface, panel + self->gap);
+    g_signal_connect_object (self->input_surface, "notify::surface-visible",
+                             G_CALLBACK (on_surface_visible), self, G_CONNECT_SWAPPED);
     if (self->activation_filter)
       g_signal_connect_object (self->activation_filter, "active-changed",
                                G_CALLBACK (on_active_window_changed), self,
diff --git a/src/pos-input-surface.c b/src/pos-input-surface.c
index c87b69a..3ef989d 100644
--- a/src/pos-input-surface.c
+++ b/src/pos-input-surface.c
@@ -91,6 +91,7 @@ typedef struct {
   double   progress;
   gint64   last_frame;
   guint    id;
+  guint    tick_id;   /* the slide's own clock, see animate_tick */
 } PosInputSurfaceAnimation;
 
 /**
@@ -1107,21 +1108,32 @@ pos_input_surface_move (PosInputSurface *self)
 }
 
 
+/*
+ * The slide runs on a timer of its own, not on GTK's frame clock. The frame
+ * clock only advances when the compositor sends the surface a frame
+ * callback, and a surface parked below the screen's edge is not drawn and
+ * gets none: the first slide up after a start stood still until the one
+ * second safety timeout set the keyboard in place in one step, and every
+ * show added another tick callback beside the ones still running, so that a
+ * hand pressing the power button over and over (phosh-patches-0.55 on a
+ * folding display) drove the slide with several at once. One timer, the
+ * same curve and length, reversed where it stands on every call.
+ */
+#define SLIDE_TICK_MS 16
+
 static gboolean
-animate_cb (GtkWidget     *widget,
-            GdkFrameClock *frame_clock,
-            gpointer       user_data)
+animate_tick (gpointer data)
 {
-  PosInputSurface *self = POS_INPUT_SURFACE (widget);
-  gint64 time;
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  gint64 now = g_get_monotonic_time (), time;
   gboolean finished = FALSE;
 
-  time = gdk_frame_clock_get_frame_time (frame_clock) - self->animation.last_frame;
+  time = now - self->animation.last_frame;
   if (self->animation.last_frame < 0)
     time = 0;
 
   self->animation.progress += 0.06666 * time / 16666.00;
-  self->animation.last_frame = gdk_frame_clock_get_frame_time (frame_clock);
+  self->animation.last_frame = now;
 
   if (self->animation.progress >= 1.0) {
     finished = TRUE;
@@ -1133,6 +1145,7 @@ animate_cb (GtkWidget     *widget,
   if (finished) {
     if (!self->animation.show)
       select_layout_by_im_purpose (self);
+    self->animation.tick_id = 0;
     return G_SOURCE_REMOVE;
   }
 
@@ -1632,6 +1645,7 @@ pos_input_surface_finalize (GObject *object)
   self->clicked_id = 0;
 
   g_clear_handle_id (&self->animation.id, g_source_remove);
+  g_clear_handle_id (&self->animation.tick_id, g_source_remove);
   g_clear_handle_id (&self->bs_repeat_id, g_source_remove);
 
   g_clear_object (&self->logind_session);
@@ -2374,7 +2388,10 @@ pos_input_surface_set_visible (PosInputSurface *self, gboolean visible)
     g_source_remove (self->animation.id);
 
   self->animation.id = g_timeout_add_seconds (1, animation_timeout_cb, self);
-  gtk_widget_add_tick_callback (GTK_WIDGET (self), animate_cb, NULL, NULL);
+  if (!self->animation.tick_id) {
+    self->animation.tick_id = g_timeout_add (SLIDE_TICK_MS, animate_tick, self);
+    g_source_set_name_by_id (self->animation.tick_id, "[PosInputSurface] slide");
+  }
 }
 
 
