#!/bin/sh
# sfduo-shell-setup: what the port needs that a fresh Droidian image does
# not have. The adaptation package only recommends these - it is installed
# offline, with dpkg, before the device has ever seen a network - so this is
# the step to run once it has one: the pen and the synthetic finger (evdev),
# the Python scripts' GTK bindings, dconf, and resize2fs for growing the
# root filesystem. The two-panel shell (item-shell) brings its own with apt.
set -e
[ "$(id -u)" = 0 ] || { echo "run as root: sudo $0" >&2; exit 1; }
apt-get update
apt-get install -y python3-gi gir1.2-gtk-3.0 dconf-cli python3-evdev e2fsprogs
dconf update
echo "done - restart the shell (systemctl restart phosh) or reboot"
