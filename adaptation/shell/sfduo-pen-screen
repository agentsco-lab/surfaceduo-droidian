#!/usr/bin/python3
"""sfduo-pen-screen: the page right of the right panel, for the pen.

    sfduo-pen-screen          run, on the session bus as org.sfduo.PenScreen

The mirror of the system screen (sfduo-system-screen, #109), at the other
end of the strip of screens - system, left desktop, right desktop, sheet:
a swipe left on a free desktop moves the strip left and brings it in over
the right panel, and a swipe right on the left panel - the right desktop by
then - takes it back; the dock drives both. It is an empty sheet, and the
pen draws on it; fingers do not. At its top right: pen or eraser, clear, and
save (a PNG in Pictures/Sketches); the barrel button held, or the pen's
other end, erases too. What is drawn stays while the phone runs.

The pen is told from a finger by GTK's stylus gesture: sfduo-pen-split
gives the pen a tablet device of its own, with pressure and buttons, apart
from the fingers' touchscreen (docs/PEN.md, #24). Without it the pen is one
more finger and draws nothing here; $XDG_RUNTIME_DIR/sfduo-pen-fingers, if
present, then lets a finger draw, to try the sheet.

Driven like the system screen by a progress 0..1 on the session bus -
Begin(), SetProgress(d), Open(), Close() - so the dock's swipe can hold it
under the finger; closed, the surface is unmapped and draws nothing.
"""
import ctypes
import datetime
import math
import os
import socket
import sys

# gtk4-layer-shell has to be in the process before libwayland-client is, or
# GTK's windows are plain toplevels (see sfduo-fold)
_LAYER_SHELL = "libgtk4-layer-shell.so.0"
if _LAYER_SHELL not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (_LAYER_SHELL + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)
try:
    ctypes.CDLL("libc.so.6").prctl(15, b"sfduo-pen", 0, 0, 0)     # PR_SET_NAME
except OSError:
    pass
os.environ.setdefault("GSK_RENDERER", "gl")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk4LayerShell  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gsk", "4.0")
gi.require_version("Graphene", "1.0")
from gi.repository import Gdk, Gio, GLib, Graphene, Gsk, Gtk  # noqa: E402

BUS_NAME = "org.sfduo.PenScreen"
BUS_PATH = "/org/sfduo/PenScreen"
HINGE_FRACTION = 84 / 2784
PAPER = (1.0, 1.0, 1.0)                   # a sheet of paper
INK = Gdk.RGBA()
INK.parse("#1c1c1e")
INK_WIDTH = 3.0                           # at full pressure; a light touch draws thinner
ERASE_WIDTH = 28.0                        # the eraser, at full pressure
SAVE_DIR = os.path.join(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
                        or os.path.expanduser("~/Pictures"), "Sketches")
CSS = b"""
.pen-tools { background-color: rgba(28, 28, 30, 0.08); border-radius: 22px; padding: 4px; }
.pen-tools button { min-width: 40px; min-height: 40px; border-radius: 20px; }
.pen-toast { background-color: rgba(28, 28, 30, 0.85); color: #ffffff; border-radius: 16px;
             padding: 8px 16px; }
"""
SLIDE_MS = 300
SWIPE_PX = 12
FRAME_MS = 16
CHASE = 0.5
PEN_SOCK = "/run/sfduo-pen.sock"          # sfduo-pen-split: where the pen is a pen
FINGERS_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sfduo-pen-fingers")

INTROSPECTION = """
<node>
  <interface name="org.sfduo.PenScreen">
    <method name="Begin"/>
    <method name="Open"/>
    <method name="Close"/>
    <method name="SetProgress"><arg name="progress" type="d" direction="in"/></method>
    <property name="Progress" type="d" access="read"/>
  </interface>
</node>
"""


def ease_out(t):
    return 1.0 - (1.0 - t) ** 3


class Sheet(Gtk.Widget):
    """The paper and what is drawn on it: strokes of (x, y, pressure) points,
    each segment as wide as its pressure says - ink, or the eraser, which is
    the paper drawn over the ink."""

    def __init__(self):
        super().__init__(hexpand=True, vexpand=True)
        self.strokes = []                 # [(erase, [(x, y, pressure), ...]), ...]

    def begin(self, x, y, pressure, erase=False):
        self.strokes.append((erase, [(x, y, pressure)]))
        self.queue_draw()

    def extend(self, x, y, pressure):
        if self.strokes:
            self.strokes[-1][1].append((x, y, pressure))
            self.queue_draw()

    def clear(self):
        self.strokes = []
        self.queue_draw()

    @staticmethod
    def _width(erase, pressure):
        return max(0.8, (ERASE_WIDTH if erase else INK_WIDTH) * pressure)

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        paper = Gdk.RGBA()
        paper.red, paper.green, paper.blue, paper.alpha = (*PAPER, 1.0)
        snapshot.append_color(paper, Graphene.Rect().init(0, 0, w, h))
        for erase, points in self.strokes:
            colour = paper if erase else INK
            if len(points) == 1:
                x, y, p = points[0]
                builder = Gsk.PathBuilder.new()
                builder.add_circle(Graphene.Point().init(x, y), self._width(erase, p) / 2)
                snapshot.append_fill(builder.to_path(), Gsk.FillRule.WINDING, colour)
                continue
            for (x0, y0, p0), (x1, y1, p1) in zip(points, points[1:]):
                builder = Gsk.PathBuilder.new()
                builder.move_to(x0, y0)
                builder.line_to(x1, y1)
                style = Gsk.Stroke.new(self._width(erase, (p0 + p1) / 2))
                style.set_line_cap(Gsk.LineCap.ROUND)
                snapshot.append_stroke(builder.to_path(), style, colour)

    def save(self, path):
        """The sheet as a PNG, drawn again with cairo at the panel's pixels."""
        scale = self.get_scale_factor()
        w, h = self.get_width() * scale, self.get_height() * scale
        surface = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
        cr = cairo.Context(surface)
        cr.scale(scale, scale)
        cr.set_source_rgb(*PAPER)
        cr.paint()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for erase, points in self.strokes:
            if erase:
                cr.set_source_rgb(*PAPER)
            else:
                cr.set_source_rgb(INK.red, INK.green, INK.blue)
            if len(points) == 1:
                x, y, p = points[0]
                cr.arc(x, y, self._width(erase, p) / 2, 0, 2 * math.pi)
                cr.fill()
                continue
            for (x0, y0, p0), (x1, y1, p1) in zip(points, points[1:]):
                cr.set_line_width(self._width(erase, (p0 + p1) / 2))
                cr.move_to(x0, y0)
                cr.line_to(x1, y1)
                cr.stroke()
        surface.write_to_png(path)


class PenScreen:
    def __init__(self, app):
        self.app = app
        self.conn = None
        self.said = None
        self.progress = 0.0
        self.target = 0.0
        self.animation = None
        self.ticking = None
        self.step = None
        self.chasing = False
        self.width = self._panel_width()

        self.window = Gtk.Window(application=app)
        self.window.set_decorated(False)
        self.window.set_default_size(self.width, -1)
        Gtk4LayerShell.init_for_window(self.window)
        Gtk4LayerShell.set_namespace(self.window, "sfduo-pen")
        Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.TOP)
        for edge in (Gtk4LayerShell.Edge.RIGHT, Gtk4LayerShell.Edge.TOP, Gtk4LayerShell.Edge.BOTTOM):
            Gtk4LayerShell.set_anchor(self.window, edge, True)
        Gtk4LayerShell.set_exclusive_zone(self.window, -1)
        Gtk4LayerShell.set_keyboard_mode(self.window, Gtk4LayerShell.KeyboardMode.NONE)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.sheet = Sheet()
        overlay = Gtk.Overlay()
        overlay.set_child(self.sheet)
        overlay.add_overlay(self._build_tools())
        self.toast = Gtk.Label(halign=Gtk.Align.CENTER, valign=Gtk.Align.END, margin_bottom=110)
        self.toast.add_css_class("pen-toast")
        self.toast.set_visible(False)
        overlay.add_overlay(self.toast)
        self.window.set_child(overlay)

        # the pen: GTK's stylus gesture, with pressure
        stylus = Gtk.GestureStylus()
        stylus.connect("down", self._on_pen_down)
        stylus.connect("motion", self._on_pen_motion)
        self.sheet.add_controller(stylus)
        # a finger draws only while FINGERS_FILE says so; it does not close
        # the sheet - the left panel does that - and the tools take its taps
        drag = Gtk.GestureDrag()
        drag.set_touch_only(True)
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        self.sheet.add_controller(drag)

    # ---- the tools ----------------------------------------------------------------

    def _build_tools(self):
        """Top right, where the hand holding the pen does not rest: pen or
        eraser, clear, save."""
        box = Gtk.Box(spacing=2, halign=Gtk.Align.END, valign=Gtk.Align.START,
                      margin_top=14, margin_end=14)
        box.add_css_class("pen-tools")
        self.pen_button = Gtk.ToggleButton(icon_name="document-edit-symbolic", active=True,
                                           tooltip_text="Pen")
        self.eraser_button = Gtk.ToggleButton(icon_name="edit-clear-symbolic", tooltip_text="Eraser")
        self.eraser_button.set_group(self.pen_button)
        clear = Gtk.Button(icon_name="edit-clear-all-symbolic", tooltip_text="Clear the sheet")
        clear.connect("clicked", lambda _b: self.sheet.clear())
        save = Gtk.Button(icon_name="document-save-symbolic", tooltip_text="Save as a picture")
        save.connect("clicked", lambda _b: self._save())
        for button in (self.pen_button, self.eraser_button, clear, save):
            button.add_css_class("flat")
            box.append(button)
        return box

    def _save(self):
        if not self.sheet.strokes:
            self._say("Nothing to save")
            return
        os.makedirs(SAVE_DIR, exist_ok=True)
        name = datetime.datetime.now().strftime("sketch-%Y-%m-%d-%H%M%S.png")
        path = os.path.join(SAVE_DIR, name)
        try:
            self.sheet.save(path)
        except (OSError, cairo.Error) as err:
            self._say(f"Not saved: {err}")
            return
        self._say(f"Saved to Pictures/Sketches/{name}")

    def _say(self, text):
        self.toast.set_text(text)
        self.toast.set_visible(True)
        if getattr(self, "toast_timer", None):
            GLib.source_remove(self.toast_timer)
        self.toast_timer = GLib.timeout_add(2200, self._hide_toast)

    def _hide_toast(self):
        self.toast.set_visible(False)
        self.toast_timer = None
        return False

    # ---- geometry ---------------------------------------------------------------

    def _panel_width(self):
        display = Gdk.Display.get_default()
        monitors = display.get_monitors()
        monitor = monitors.get_item(0) if monitors.get_n_items() else None
        width = monitor.get_geometry().width if monitor else 1392
        gap = max(1, round(width * HINGE_FRACTION))
        return (width - gap) // 2

    # ---- the pen ----------------------------------------------------------------

    @staticmethod
    def _pressure(gesture):
        ok, value = gesture.get_axis(Gdk.AxisUse.PRESSURE)
        return value if ok and value > 0 else 1.0

    def _erasing(self, gesture):
        """The eraser: chosen in the tools, the pen's other end, or the
        barrel button held down."""
        if self.eraser_button.get_active():
            return True
        tool = gesture.get_device_tool()
        if tool is not None and tool.get_tool_type() == Gdk.DeviceToolType.ERASER:
            return True
        state = gesture.get_current_event_state()
        return bool(state & (Gdk.ModifierType.BUTTON2_MASK | Gdk.ModifierType.BUTTON3_MASK))

    def _on_pen_down(self, gesture, x, y):
        self.sheet.begin(x, y, self._pressure(gesture), erase=self._erasing(gesture))

    def _on_pen_motion(self, gesture, x, y):
        erase = self._erasing(gesture)
        if self.sheet.strokes and self.sheet.strokes[-1][0] != erase:
            # the barrel button pressed or let go on the way: a new stroke,
            # the other kind, from here
            self.sheet.begin(x, y, self._pressure(gesture), erase=erase)
            return
        self.sheet.extend(x, y, self._pressure(gesture))

    # ---- a finger -----------------------------------------------------------------

    @staticmethod
    def _fingers_draw():
        return os.path.exists(FINGERS_FILE)

    def _on_drag_begin(self, gesture, x, y):
        self.drag_drawing = False
        self.drag_origin = (x, y)

    def _on_drag_update(self, gesture, dx, dy):
        """A finger draws only while FINGERS_FILE says so; otherwise the drag
        is not this sheet's."""
        if not self.drag_drawing:
            if abs(dx) < SWIPE_PX and abs(dy) < SWIPE_PX:
                return
            if not self._fingers_draw():
                gesture.set_state(Gtk.EventSequenceState.DENIED)
                return
            self.drag_drawing = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.sheet.begin(*self.drag_origin, 1.0)
        ox, oy = self.drag_origin
        self.sheet.extend(ox + dx, oy + dy, 1.0)

    # ---- where it stands ----------------------------------------------------------

    def apply(self, progress):
        self.progress = max(0.0, min(1.0, progress))
        if self.progress <= 0.0:
            self.window.set_visible(False)
            self._say_progress()
            return
        if not self.window.get_visible():
            self.window.present()
        # one pixel stays on the screen however little is open: a surface
        # wholly off it gets no frame callbacks and would never come back (#133)
        hidden = min(self.width - 1, int(round(self.width * (1 - self.progress))))
        Gtk4LayerShell.set_margin(self.window, Gtk4LayerShell.Edge.RIGHT, -hidden)
        self.sheet.queue_draw()
        self._say_progress()

    def _tell_split(self):
        """Tell sfduo-pen-split whether the pen draws here: only with the sheet
        all the way out. Anywhere else, and on its way, the pen is a finger."""
        out = self.progress >= 1.0
        if out == getattr(self, "told_out", None):
            return
        self.told_out = out
        try:
            sock = getattr(self, "split_sock", None)
            if sock is None:
                sock = self.split_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
                sock.setblocking(False)
            sock.sendto(b"1" if out else b"0", PEN_SOCK)
        except OSError:
            self.told_out = None              # no splitter yet: say it again next time

    def _say_progress(self):
        self._tell_split()
        p = self.progress
        if self.conn is None or (self.said is not None and abs(p - self.said) < 0.004
                                 and p not in (0.0, 1.0)) or p == self.said:
            return
        self.said = p
        self.conn.emit_signal(None, BUS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              GLib.Variant("(sa{sv}as)", (BUS_NAME, {"Progress": GLib.Variant("d", p)}, [])))

    # ---- motion: the system screen's frame clock and watchdog ---------------------

    def animate_to(self, target):
        self.chasing = False
        start, t0 = self.progress, GLib.get_monotonic_time()
        if target > 0 and not self.window.get_visible():
            self.apply(0.001)

        def step():
            t = min(1.0, (GLib.get_monotonic_time() - t0) / 1000.0 / SLIDE_MS)
            self.apply(start + (target - start) * ease_out(t))
            if t >= 1.0:
                self._stop()
                return False
            return True
        self._drive(step)

    def begin(self):
        if self.progress <= 0.0:
            self.set_progress(0.001)

    def set_progress(self, progress):
        self.target = max(0.0, min(1.0, progress))
        if self.animation is not None and self.chasing:
            return
        self.chasing = True
        if self.target > 0 and not self.window.get_visible():
            self.apply(0.001)

        def step():
            left = self.target - self.progress
            if abs(left) * self.width < 0.5:
                self.apply(self.target)
                self.chasing = False
                self._stop()
                return False
            self.apply(self.progress + left * CHASE)
            return True
        self._drive(step)

    def _drive(self, step):
        self.step = step
        self.last_step = GLib.get_monotonic_time()
        if self.ticking is None:
            self.ticking = self.window.add_tick_callback(self._on_tick)
        if self.animation is None:
            self.animation = GLib.timeout_add(FRAME_MS, self._on_watchdog)

    def _on_tick(self, _widget, _clock):
        if self.step is None:
            self.ticking = None
            return GLib.SOURCE_REMOVE
        self.last_step = GLib.get_monotonic_time()
        return GLib.SOURCE_CONTINUE if self.step() else GLib.SOURCE_REMOVE

    def _on_watchdog(self):
        if self.step is None:
            self.animation = None
            return False
        now = GLib.get_monotonic_time()
        if now - self.last_step > 2 * FRAME_MS * 1000:
            self.last_step = now
            return self.step()
        return True

    def _stop(self):
        self.step = None
        if self.animation is not None:
            GLib.source_remove(self.animation)
            self.animation = None
        if self.ticking is not None:
            self.window.remove_tick_callback(self.ticking)
            self.ticking = None

    # ---- the bus ------------------------------------------------------------------

    def on_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "Open":
            self.animate_to(1.0)
        elif method == "Close":
            self.animate_to(0.0)
        elif method == "Begin":
            self.begin()
        elif method == "SetProgress":
            self.set_progress(params.unpack()[0])
        invocation.return_value(None)

    def on_property(self, _conn, _sender, _path, _iface, name):
        return GLib.Variant("d", self.progress) if name == "Progress" else None


def main():
    if os.path.exists("/etc/sfduo/phosh-stock"):
        print("sfduo-pen-screen: the packaged phosh is kept - no pen screen", file=sys.stderr)
        return
    app = Gtk.Application(application_id="org.sfduo.PenScreenApp",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(app):
        screen = PenScreen(app)
        app.hold()
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)

        def acquired(conn, _name):
            conn.register_object(BUS_PATH, node.interfaces[0], screen.on_method, screen.on_property, None)
            screen.conn = conn
            screen._say_progress()

        def lost(_conn, _name):
            print("sfduo-pen-screen: the name is taken - leaving", file=sys.stderr)
            app.quit()
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE, acquired, None, lost)

    app.connect("activate", activate)
    app.run([sys.argv[0]])


if __name__ == "__main__":
    main()
