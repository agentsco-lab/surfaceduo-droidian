diff --git a/core/sockethandler.cpp b/core/sockethandler.cpp
index fa07ced..4790877 100644
--- a/core/sockethandler.cpp
+++ b/core/sockethandler.cpp
@@ -28,6 +28,7 @@
 
 #include <QLocalSocket>
 #include <QLocalServer>
+#include <QTimer>
 #include <sys/socket.h>
 #include <sys/time.h>
 #include "logging.h"
@@ -260,7 +261,22 @@ bool SocketHandler::write(int id, const void* source, int size)
         sensordLogD() << "[SocketHandler]: Trying to write to nonexistent session (normal, no panic).";
         return false;
     }
-    return (*it)->write(source, size);
+    if ((*it)->write(source, size))
+        return true;
+    // The client gone without a word (killed: no disconnect noticed) - its
+    // session lost, its sensor stopped, not written to forever (Surface Duo,
+    // 2026-10-07: ~100 writes a second all night, the phone kept awake).
+    QLocalSocket* socket = (*it)->getSocket();
+    if (socket && socket->state() != QLocalSocket::ConnectedState && !m_lost.contains(id)) {
+        m_lost.insert(id);
+        sensordLogW() << "[SocketHandler]: Client of session" << id << "is gone:" << socket->errorString() << "- session lost";
+        QTimer::singleShot(0, this, [this, id]() {
+            m_lost.remove(id);
+            if (m_idMap.contains(id))
+                emit lostSession(id);
+        });
+    }
+    return false;
 }
 
